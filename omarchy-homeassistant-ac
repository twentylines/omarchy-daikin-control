        "history_custom": history_custom,
        "history_source": selected_history_source,
        "history_remote_target": remote_target,
        "history_remote_port": remote_port,
        "history_remote_url": remote_url,
        "history_remote_path": remote_path,
    }
    payload.update(experimental_settings(config))
    return emit(payload)


def read_setup_payload() -> dict[str, Any]:
    """Read setup credentials from stdin so the token never appears in argv."""
    raw = sys.stdin.readline().strip()
    if not raw:
        raise HomeAssistantError("No Home Assistant setup details were received")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise HomeAssistantError("Home Assistant setup details were not valid JSON") from exc
    if not isinstance(payload, dict):
        raise HomeAssistantError("Home Assistant setup details must be a JSON object")
    return payload


def _config_file_bool(value: Any, name: str, default: bool) -> bool:
    """Parse a JSON boolean while accepting the values used by the UI."""
    if value is None:
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, (int, float)) and value in {0, 1}:
        return bool(value)
    if isinstance(value, str) and value.strip().lower() in {
        "0", "1", "false", "true", "off", "on", "no", "yes"
    }:
        return preference_enabled(value)
    raise HomeAssistantError(f"{name} must be true or false")


def _config_file_number(value: Any, name: str, minimum: float, maximum: float) -> float:
    if isinstance(value, bool):
        raise HomeAssistantError(f"{name} must be between {minimum:g} and {maximum:g}")
    try:
        parsed = float(value)
    except (TypeError, ValueError) as exc:
        raise HomeAssistantError(
            f"{name} must be between {minimum:g} and {maximum:g}"
        ) from exc
    if parsed != parsed or not minimum <= parsed <= maximum:
        raise HomeAssistantError(f"{name} must be between {minimum:g} and {maximum:g}")
    return round(parsed, 2)


def _config_file_color(value: Any, name: str, default: str) -> str:
    text = str(value if value is not None else "").strip()
    if not APPEARANCE_HEX_PATTERN.fullmatch(text):
        raise HomeAssistantError(f"{name} must be a six-digit hex value such as #8FA79F")
    return text.upper()


def _config_file_entity_list(value: Any, fallback: Any, name: str) -> list[str]:
    if isinstance(value, (list, tuple)):
        raw_items = list(value)
    elif isinstance(value, str):
        raw_items = value.split(",")
    else:
        raise HomeAssistantError(f"{name} must be a list of climate entity IDs")
    normalized: list[str] = []
    for item in raw_items:
        entity_id = climate_entity_id(item)
        if not entity_id:
            raise HomeAssistantError(f"{name} contains an invalid climate entity ID")
        if entity_id not in normalized:
            normalized.append(entity_id)
        if len(normalized) >= MAX_SELECTED_ENTITIES:
            break
    if not normalized:
        normalized = selected_entity_ids(fallback)
    if not normalized:
        raise HomeAssistantError(f"{name} must contain at least one climate entity ID")
    return normalized


def _config_file_color_map(value: Any) -> dict[str, str]:
    if not isinstance(value, dict):
        raise HomeAssistantError("appearance_device_colors must be a JSON object")
    result: dict[str, str] = {}
    for entity_id, color in value.items():
        normalized_id = climate_entity_id(entity_id)
        normalized_color = str(color or "").strip()
        if not normalized_id:
            raise HomeAssistantError("appearance_device_colors contains an invalid climate entity ID")
        if not APPEARANCE_HEX_PATTERN.fullmatch(normalized_color):
            raise HomeAssistantError(
                "appearance_device_colors must contain six-digit hex colours"
            )
        if normalized_id not in result:
            result[normalized_id] = normalized_color.upper()
        if len(result) >= MAX_SELECTED_ENTITIES:
            break
    return result


def _config_file_shortcuts(
    value: Any, current_config: dict[str, Any]
) -> dict[str, dict[str, Any]]:
    if not isinstance(value, dict):
        raise HomeAssistantError("shortcuts must be a JSON object")
    current = shortcut_settings(current_config)
    result: dict[str, dict[str, Any]] = {}
    for name, default in SHORTCUT_DEFAULTS.items():
        item = value.get(name, current[name])
        if isinstance(item, str):
            item = {"key": item}
        if not isinstance(item, dict):
            raise HomeAssistantError(f"shortcuts.{name} must be an object")
        key = normalize_shortcut(item.get("key", current[name]["key"]))
        if not key:
            raise HomeAssistantError(f"shortcuts.{name}.key is not a valid shortcut")
        enabled = _config_file_bool(
            item.get("enabled"), f"shortcuts.{name}.enabled", current[name]["enabled"]
        )
        result[name] = {"key": key, "enabled": enabled}
    return result


def config_file_snapshot(config: dict[str, Any]) -> dict[str, Any]:
    """Return editable preferences without exposing connection credentials."""
    (
        _url,
        _token,
        entity_id,
        advanced_controls,
        master_switch_enabled,
        display,
        history_enabled,
        selected_history_hours,
        history_custom,
        selected_history_source,
        remote_target,
        remote_port,
        remote_url,
        remote_path,
    ) = config_values(config)
    payload: dict[str, Any] = {
        "config_version": 1,
        "entity_id": entity_id,
        "advanced_controls": advanced_controls,
        "master_switch_enabled": master_switch_enabled,
        "temperature_display": display,
        "history_enabled": history_enabled,
        "history_hours": selected_history_hours,
        "history_custom": history_custom,
        "history_source": selected_history_source,
        "history_remote_target": remote_target,
        "history_remote_port": remote_port,
        "history_remote_url": remote_url,
        "history_remote_path": remote_path,
    }
    payload.update(experimental_settings(config))
    return payload


def set_config_file(config: dict[str, Any], payload: dict[str, Any]) -> int:
    """Validate and save a keyboard-editable preference document atomically."""
    if not isinstance(payload, dict):
        raise HomeAssistantError("The config file must contain a JSON object")

    current_snapshot = config_file_snapshot(config)
    next_config = dict(config)

    entity_id = str(current_snapshot.get("entity_id") or "").strip()
    if "entity_id" in payload:
        entity_id = climate_entity_id(payload["entity_id"])
        if not entity_id:
            raise HomeAssistantError("entity_id must be a valid climate entity ID")
    next_config["entity_id"] = entity_id

    bool_keys = {
        "advanced_controls",
        "master_switch_enabled",
        "history_enabled",
        "multi_unit_enabled",
        "global_sync_controls",
        "sync_non_power_controls",
        "average_temperature_decimals",
        "experimental_history_enabled",
        "shortcuts_enabled",
        "global_tab_navigation_enabled",
        "config_file_mode_enabled",
        "custom_appearance_enabled",
        "appearance_auto_accent",
        "appearance_auto_background",
        "appearance_device_colors_enabled",
        "appearance_compact",
    }
    for name in bool_keys:
        next_config[name] = _config_file_bool(
            payload.get(name), name, bool(current_snapshot.get(name))
        )

    display = str(payload.get("temperature_display", current_snapshot["temperature_display"])).strip().lower()
    if display not in {"ambient", "target", "both"}:
        raise HomeAssistantError("temperature_display must be ambient, target, or both")
    next_config["temperature_display"] = display

    source = str(payload.get("history_source", current_snapshot["history_source"])).strip().lower()
    if source not in {"local", "server"}:
        raise HomeAssistantError("history_source must be local or server")
    next_config["history_source"] = source

    history_hours = _config_file_number(
        payload.get("history_hours", current_snapshot["history_hours"]),
        "history_hours",
        1,
        MAX_HISTORY_HOURS,
    )
    history_custom = _config_file_bool(
        payload.get("history_custom"), "history_custom", bool(current_snapshot["history_custom"])
    )
    if not next_config["experimental_history_enabled"]:
        history_hours = min(history_hours, 24)
        history_custom = False
    next_config["history_hours"] = history_hours
    next_config["history_custom"] = history_custom

    current_remote = remote_history_settings(config)
    next_config["history_remote_target"] = remote_history_target(
        payload.get("history_remote_target", current_remote[0])
    )
    next_config["history_remote_port"] = remote_history_port(
        payload.get("history_remote_port", current_remote[1])
    )
    next_config["history_remote_url"] = normalize_url(
        payload.get("history_remote_url", current_remote[2])
    )
    next_config["history_remote_path"] = remote_history_path(
        payload.get("history_remote_path", current_remote[3])
    )

    if "selected_entities" in payload:
        selected = _config_file_entity_list(payload["selected_entities"], entity_id, "selected_entities")
    else:
        selected = selected_entity_ids(config.get("selected_entities"), entity_id)
    next_config["selected_entities"] = selected
    if "bar_temperature_entities" in payload:
        next_config["bar_temperature_entities"] = _config_file_entity_list(
            payload["bar_temperature_entities"], selected, "bar_temperature_entities"
        )
    else:
        next_config["bar_temperature_entities"] = selected_entity_ids(
            config.get("bar_temperature_entities"), selected
        )

    mode = str(payload.get("bar_temperature_mode", current_snapshot["bar_temperature_mode"])).strip().lower()
    if mode not in {"average", "all", "selected"}:
        raise HomeAssistantError("bar_temperature_mode must be average, all, or selected")
    next_config["bar_temperature_mode"] = mode

    next_config["temperature_unit"] = temperature_unit_preference(
        payload.get("temperature_unit", current_snapshot["temperature_unit"])
    )
    if next_config["temperature_unit"] == "source" and str(
        payload.get("temperature_unit", current_snapshot["temperature_unit"])
    ).strip().lower() not in {"source", "celsius", "fahrenheit", "kelvin"}:
        raise HomeAssistantError(
            "temperature_unit must be source, celsius, fahrenheit, or kelvin"
        )

    next_config["shortcuts"] = _config_file_shortcuts(
        payload.get("shortcuts", current_snapshot["shortcuts"]), config
    )

    color_defaults = {
        "appearance_accent": DEFAULT_APPEARANCE_ACCENT,
        "appearance_control": DEFAULT_APPEARANCE_CONTROL,
        "appearance_background": DEFAULT_APPEARANCE_BACKGROUND,
    }
    for name, default in color_defaults.items():
        next_config[name] = _config_file_color(
            payload.get(name, current_snapshot.get(name, default)), name, default
        )
    if "appearance_device_colors" in payload:
        next_config["appearance_device_colors"] = _config_file_color_map(
            payload["appearance_device_colors"]
        )
    else:
        next_config["appearance_device_colors"] = appearance_color_map(
            config.get("appearance_device_colors")
        )
    next_config["appearance_transparency"] = _config_file_number(
        payload.get("appearance_transparency", current_snapshot["appearance_transparency"]),
        "appearance_transparency",
        0,
        100,
    )
    next_config["appearance_blur"] = _config_file_number(
        payload.get("appearance_blur", current_snapshot["appearance_blur"]),
        "appearance_blur",
        0,
        24,
    )
    next_config["appearance_radius"] = _config_file_number(
        payload.get("appearance_radius", current_snapshot["appearance_radius"]),
        "appearance_radius",
        8,
        32,
    )

    try:
        save_config(next_config)
    except OSError as exc:
        raise HomeAssistantError(f"Cannot save the AC configuration: {exc}") from exc
    config.clear()
    config.update(next_config)

    shortcut_sync_error = ""
    if {
        "shortcuts_enabled",
        "shortcuts",
        "multi_unit_enabled",
        "global_sync_controls",
    } & payload.keys():
        shortcut_sync_error = sync_hyprland_shortcuts(next_config)

    response = {
        "ok": True,
        "preference": "config_file",
        "config_file_saved": True,
        **config_file_snapshot(next_config),
    }
    if shortcut_sync_error:
        response["shortcut_sync_error"] = shortcut_sync_error
    return emit(response)


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".home-assistant-ac.", dir=CONFIG_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, CONFIG_PATH)
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def configure(payload: dict[str, Any], current_config: dict[str, Any]) -> int:
    """Validate credentials, select an entity, and persist a working setup."""
    try:
        url = normalize_url(payload.get("url") or current_config.get("url") or DEFAULT_URL)
    except HomeAssistantError as exc:
        return fail(str(exc), configured=False)
    token = str(payload.get("token") or "").strip()
    if not token and payload.get("reuse_saved_token") is True:
        try:
            saved_url = normalize_url(current_config.get("url") or DEFAULT_URL)
        except HomeAssistantError:
            saved_url = ""
        if saved_url == url:
            token = str(current_config.get("token") or "").strip()
    if not token:
        return fail("Paste a Home Assistant long-lived access token to continue", configured=False, url=url)

    try:
        # /api/ is cheap and gives a clear authentication error before we ask
        # for the full state list.
        api_request(url, token, "GET", "/api/")
        entities = list_entities(url, token)
    except HomeAssistantError as exc:
        return fail(str(exc), configured=False, url=url)

    if not entities:
        return fail(
            "Home Assistant is reachable, but no available climate entity was found. "
            "Finish the Daikin integration first, then try again.",
            configured=False,
            url=url,
        )

    requested_entity = str(payload.get("entity_id") or "").strip()
    if requested_entity:
        matching = next((item for item in entities if item["id"] == requested_entity), None)
        if matching is None:
            return fail(
                "Choose an available air conditioner from the device list.",
                configured=False,
                url=url,
                entities=entities,
                needs_entity=True,
            )
        entity_id = requested_entity
    elif len(entities) == 1:
        entity_id = entities[0]["id"]
    else:
        return emit({
            "ok": True,
            "configured": False,
            "url": url,
            "entities": entities,
            "needs_entity": True,
        })

    available_ids = {str(item["id"]) for item in entities}
    previous_experimental = experimental_settings(current_config)
    if previous_experimental["multi_unit_enabled"]:
        selected_ids = [
            item for item in selected_entity_ids(current_config.get("selected_entities"), entity_id)
            if item in available_ids
        ]
        if entity_id not in selected_ids:
            selected_ids.insert(0, entity_id)
    else:
        selected_ids = [entity_id]

    config = {
        "url": url,
        "token": token,
        "entity_id": entity_id,
        "advanced_controls": preference_enabled(
            payload["advanced_controls"] if "advanced_controls" in payload
            else current_config.get("advanced_controls", True)
        ),
        "master_switch_enabled": preference_enabled(
            payload["master_switch_enabled"] if "master_switch_enabled" in payload
            else current_config.get("master_switch_enabled", False)
        ),
        "temperature_display": temperature_display(current_config.get("temperature_display")),
        "history_enabled": preference_enabled(current_config.get("history_enabled")),
        "history_hours": effective_history_settings(current_config)[0],
        "history_custom": effective_history_settings(current_config)[1],
        "history_source": history_source(current_config.get("history_source")),
        "history_remote_target": remote_history_target(current_config.get("history_remote_target")),
        "history_remote_port": remote_history_port(current_config.get("history_remote_port", 22)),
        "history_remote_url": normalize_url(
            current_config.get("history_remote_url") or REMOTE_HISTORY_DEFAULT_URL
        ),
        "history_remote_path": remote_history_path(current_config.get("history_remote_path")),
        "multi_unit_enabled": previous_experimental["multi_unit_enabled"],
        "global_sync_controls": previous_experimental["global_sync_controls"],
        "sync_non_power_controls": previous_experimental["sync_non_power_controls"],
        "average_temperature_decimals": previous_experimental["average_temperature_decimals"],
        "temperature_unit": previous_experimental["temperature_unit"],
        "selected_entities": selected_ids,
        "bar_temperature_mode": previous_experimental["bar_temperature_mode"],
        "bar_temperature_entities": previous_experimental["bar_temperature_entities"],
        "experimental_history_enabled": previous_experimental["experimental_history_enabled"],
        "shortcuts_enabled": previous_experimental["shortcuts_enabled"],
        "global_tab_navigation_enabled": previous_experimental["global_tab_navigation_enabled"],
        "config_file_mode_enabled": previous_experimental["config_file_mode_enabled"],
        "shortcuts": previous_experimental["shortcuts"],
        "custom_appearance_enabled": previous_experimental["custom_appearance_enabled"],
        "appearance_auto_accent": previous_experimental["appearance_auto_accent"],
        "appearance_auto_background": previous_experimental["appearance_auto_background"],
        "appearance_accent": previous_experimental["appearance_accent"],
        "appearance_control": previous_experimental["appearance_control"],
        "appearance_background": previous_experimental["appearance_background"],
        "appearance_device_colors_enabled": previous_experimental[
            "appearance_device_colors_enabled"
        ],
        "appearance_device_colors": previous_experimental["appearance_device_colors"],
        "appearance_transparency": previous_experimental["appearance_transparency"],
        "appearance_blur": previous_experimental["appearance_blur"],
        "appearance_radius": previous_experimental["appearance_radius"],
        "appearance_compact": previous_experimental["appearance_compact"],
    }
    if current_config.get("poll_seconds") is not None:
        config["poll_seconds"] = current_config["poll_seconds"]
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the Home Assistant configuration: {exc}", configured=False, url=url)
    if preference_enabled(config.get("shortcuts_enabled")):
        sync_hyprland_shortcuts(config)

    selected = next(item for item in entities if item["id"] == entity_id)
    return emit({
        "ok": True,
        "configured": True,
        "url": url,
        "entity_id": entity_id,
        "name": selected["name"],
        "entities": entities,
        "advanced_controls": config["advanced_controls"],
        "master_switch_enabled": config["master_switch_enabled"],
        "temperature_display": config["temperature_display"],
        "history_enabled": config["history_enabled"],
        "history_hours": config["history_hours"],
        "history_custom": config["history_custom"],
        "history_source": config["history_source"],
        "history_remote_target": config["history_remote_target"],
        "history_remote_port": config["history_remote_port"],
        "history_remote_url": config["history_remote_url"],
        "history_remote_path": config["history_remote_path"],
        **experimental_settings(config),
    })


def climate_device_info(attrs: dict[str, Any]) -> str:
    nested = attrs.get("device_info") if isinstance(attrs.get("device_info"), dict) else {}

    def first_text(*values: Any) -> str:
        for value in values:
            text = str(value or "").strip()
            if text:
                return text
        return ""

    manufacturer = first_text(
        attrs.get("manufacturer"), attrs.get("brand"), attrs.get("make"),
        nested.get("manufacturer"), nested.get("brand"), nested.get("make"),
    ) or "Daikin"
    model = first_text(
        attrs.get("model"), attrs.get("model_name"), attrs.get("model_id"), attrs.get("device_model"),
        nested.get("model"), nested.get("model_name"), nested.get("model_id"),
    )
    if not model or model.casefold() == manufacturer.casefold():
        return manufacturer
    if manufacturer.casefold() in model.casefold():
        return model
    return f"{manufacturer} ({model})"


def state_payload(state: dict[str, Any], entity_ids: list[str]) -> dict[str, Any]:
    attrs = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
    entity_id = str(state.get("entity_id") or entity_ids[0])
    modes = attrs.get("hvac_modes") if isinstance(attrs.get("hvac_modes"), list) else []
    fan_modes = attrs.get("fan_modes") if isinstance(attrs.get("fan_modes"), list) else []
    return {
        "ok": True,
        "entity_id": entity_id,
        "name": str(attrs.get("friendly_name") or entity_id),
        "device_info": climate_device_info(attrs),
        "state": str(state.get("state") or "unknown"),
        "ambient": number(attrs.get("current_temperature")),
        "target": number(attrs.get("temperature", attrs.get("target_temperature"))),
        "unit": temperature_unit(attrs.get("temperature_unit")),
        "step": number(attrs.get("target_temp_step")) or 1.0,
        "min_temp": number(attrs.get("min_temp")),
        "max_temp": number(attrs.get("max_temp")),
        "hvac_modes": [str(mode) for mode in modes],
        "fan_mode": str(attrs.get("fan_mode") or ""),
        "fan_modes": [str(mode) for mode in fan_modes],
        "history": [],
        "history_source": "local",
        "history_server": "",
        "history_error": "",
        "history_available": False,
        "history_ping_ms": -1,
        "last_changed": state.get("last_changed"),
        "last_updated": state.get("last_updated"),
    }


def status(
    url: str,
    token: str,
    configured_entity: str,
    config: dict[str, Any] | None = None,
) -> int:
    active_entity = climate_entity_id(configured_entity)
    selected = configured_entity_ids(config or {}, configured_entity)
    request_started = time.monotonic()
    if len(selected) > 1:
        states = resolve_states(url, token, selected)
        selected = [str(state.get("entity_id") or "") for state in states]
    else:
        state, resolved_ids = resolve_state(url, token, configured_entity)
        states = [state]
        selected = resolved_ids
    ping_ms = round(max(0.0, (time.monotonic() - request_started) * 1000), 1)

    units = [state_payload(state, [str(state.get("entity_id") or selected[index])])
             for index, state in enumerate(states)]
    primary_index = next(
        (index for index, unit_payload in enumerate(units)
         if unit_payload["entity_id"] == active_entity),
        0,
    )
    history_available = False
    history_ping_ms = -1
    if config is not None and history_source(config.get("history_source")) == "server":
        target = remote_history_target(config.get("history_remote_target"))
        server_name = remote_history_display_name(target) if target else "NOT CONFIGURED"
        history_started = time.monotonic()
        try:
            remote_history = load_remote_temperature_history(config)
            history_ping_ms = round(max(0.0, (time.monotonic() - history_started) * 1000), 1)
            history_available = True
            for unit_payload in units:
                unit_payload["history_source"] = "server"
                unit_payload["history_server"] = server_name
                unit_payload["history"] = remote_history.get(unit_payload["entity_id"], [])
                unit_payload["history_available"] = True
                unit_payload["history_ping_ms"] = history_ping_ms
        except HomeAssistantError as exc:
            for unit_payload in units:
                unit_payload["history_source"] = "server"
                unit_payload["history_server"] = server_name
                unit_payload["history"] = []
                unit_payload["history_error"] = str(exc)
                unit_payload["history_available"] = False
                unit_payload["history_ping_ms"] = -1
    else:
        for unit_payload in units:
            unit_payload["history"] = record_temperature_history(
                unit_payload["entity_id"], unit_payload.get("ambient"), unit_payload["unit"]
            )

    # Copy the primary payload before adding the aggregate metadata; otherwise
    # the top-level object would contain itself through `units`.
    payload = dict(units[primary_index])
    payload["units"] = units
    payload["selected_entities"] = selected
    payload["multi_unit_enabled"] = preference_enabled((config or {}).get("multi_unit_enabled"))
    payload["global_sync_controls"] = preference_enabled(
        (config or {}).get("global_sync_controls", True)
    )
    payload["sync_non_power_controls"] = preference_enabled(
        (config or {}).get("sync_non_power_controls", True)
    )
    payload["ping_ms"] = ping_ms
    payload["history_available"] = history_available
    payload["history_ping_ms"] = history_ping_ms
    return emit(payload)


def call_service(url: str, token: str, service: str, data: dict[str, Any]) -> None:
    api_request(url, token, "POST", f"/api/services/climate/{service}", data)


def request_may_have_reached_home_assistant(error: HomeAssistantError) -> bool:
    message = str(error).lower()
    return any(marker in message for marker in ("timed out", "timeout", "cannot reach", "unreachable"))


def verify_power_state(
    url: str, token: str, entity_ids: list[str], expected_on: bool
) -> list[str] | None:
    """Verify only the entities involved in a power operation."""
    try:
        entities = list_entities(url, token)
    except HomeAssistantError:
        return None
    states = {str(entity["id"]): str(entity.get("state") or "").lower() for entity in entities}
    if all(
        entity_id in states and (states[entity_id] != "off") == expected_on
        for entity_id in entity_ids
    ):
        return list(entity_ids)
    return None


def action_states(
    url: str,
    token: str,
    configured_entity: str,
    target_entity_ids: list[str] | None,
) -> tuple[list[dict[str, Any]], list[str]]:
    if target_entity_ids is None:
        state, entity_ids = resolve_state(url, token, configured_entity)
        return [state], entity_ids
    requested_ids = selected_entity_ids(target_entity_ids, configured_entity)
    states = resolve_states(url, token, requested_ids)
    resolved_ids = [str(state.get("entity_id") or "") for state in states]
    return states, resolved_ids


def service_entity_value(entity_ids: list[str]) -> str | list[str]:
    return entity_ids[0] if len(entity_ids) == 1 else entity_ids


def set_temperature(
    url: str,
    token: str,
    configured_entity: str,
    raw_value: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    try:
        requested = float(raw_value)
    except ValueError:
        return fail("Target temperature must be a number")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    for payload in payloads:
        minimum = payload.get("min_temp")
        maximum = payload.get("max_temp")
        if minimum is not None and requested < minimum:
            return fail(f"Target temperature is below the device minimum ({minimum:g}{payload['unit']})")
        if maximum is not None and requested > maximum:
            return fail(f"Target temperature is above the device maximum ({maximum:g}{payload['unit']})")
    requested = round(requested, 2)
    call_service(url, token, "set_temperature", {
        "entity_id": service_entity_value(entity_ids),
        "temperature": requested,
    })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_target": requested,
    })


def set_entity(config: dict[str, Any], entity_id: str) -> int:
    entity_id = entity_id.strip()
    if not entity_id.startswith("climate.") or any(char.isspace() for char in entity_id):
        return fail("Entity ID must look like climate.room_name")
    config["entity_id"] = entity_id
    if preference_enabled(config.get("multi_unit_enabled")):
        selected = selected_entity_ids(config.get("selected_entities"), entity_id)
        if entity_id not in selected:
            selected.insert(0, entity_id)
        config["selected_entities"] = selected
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the AC configuration: {exc}")
    if preference_enabled(config.get("shortcuts_enabled")):
        sync_hyprland_shortcuts(config)
    return emit({"ok": True, "entity_id": entity_id})


def set_power(
    url: str,
    token: str,
    configured_entity: str,
    requested_power: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested_power = requested_power.strip().lower()
    if requested_power not in {"on", "off"}:
        return fail("Power state must be on or off")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    target_modes: list[str] = []
    for payload in payloads:
        available_modes = [str(mode) for mode in payload["hvac_modes"]]
        modes = {mode.casefold(): mode for mode in available_modes}
        if requested_power == "on":
            preferred = next(
                (modes[mode] for mode in ("cool", "auto", "heat", "dry", "fan_only") if mode in modes),
                None,
            )
            if preferred is None:
                preferred = next((mode for mode in available_modes if mode.casefold() != "off"), None)
            if preferred is None:
                return fail("The climate entity has no mode available for powering on")
            target_modes.append(preferred)
        else:
            target_modes.append("off")
    if len(set(mode.casefold() for mode in target_modes)) == 1:
        call_service(url, token, "set_hvac_mode", {
            "entity_id": service_entity_value(entity_ids),
            "hvac_mode": target_modes[0],
        })
    else:
        for entity_id, target_mode in zip(entity_ids, target_modes):
            call_service(url, token, "set_hvac_mode", {
                "entity_id": entity_id,
                "hvac_mode": target_mode,
            })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_mode": target_modes[0] if len(set(target_modes)) == 1 else target_modes,
    })


def set_hvac_mode(
    url: str,
    token: str,
    configured_entity: str,
    raw_mode: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested = raw_mode.strip()
    if not requested:
        return fail("Choose a climate mode")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    selected_modes: list[str] = []
    for payload in payloads:
        available = [str(mode) for mode in payload["hvac_modes"]]
        selected = next((mode for mode in available if mode.casefold() == requested.casefold()), None)
        if selected is None:
            return fail("That climate mode is not available for every selected air conditioner")
        selected_modes.append(selected)
    selected = selected_modes[0]
    call_service(url, token, "set_hvac_mode", {
        "entity_id": service_entity_value(entity_ids),
        "hvac_mode": selected,
    })
    restarting = selected.casefold() != "off"
    if restarting:
        call_service(url, token, "turn_on", {"entity_id": service_entity_value(entity_ids)})
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_mode": selected,
        "restarting": restarting,
    })


def set_fan_mode(
    url: str,
    token: str,
    configured_entity: str,
    raw_mode: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested = raw_mode.strip()
    if not requested:
        return fail("Choose a fan speed")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    selected_modes: list[str] = []
    for payload in payloads:
        available = [str(mode) for mode in payload["fan_modes"]]
        selected = next((mode for mode in available if mode.casefold() == requested.casefold()), None)
        if selected is None:
            if available:
                return fail("That fan speed is not available for every selected air conditioner")
            return fail("The selected air conditioner does not expose fan-speed controls")
        selected_modes.append(selected)
    selected = selected_modes[0]
    call_service(url, token, "set_fan_mode", {
        "entity_id": service_entity_value(entity_ids),
        "fan_mode": selected,
    })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_fan_mode": selected,
    })


def reset_app() -> int:
    """Remove only Daikin Air's saved connection, preferences, and history."""
    removed: list[str] = []
    for path in (CONFIG_PATH, HISTORY_PATH):
        try:
            path.unlink()
        except FileNotFoundError:
            continue
        except OSError as exc:
            return fail(f"Cannot reset Daikin Air data at {path}: {exc}")
        removed.append(str(path))
    sync_hyprland_shortcuts({})
    return emit({"ok": True, "reset": True, "removed": removed})


def set_selection(config: dict[str, Any], payload: dict[str, Any]) -> int:
    """Persist the visible multi-aircon list and its active entity."""
    active = climate_entity_id(payload.get("entity_id") or config.get("entity_id"))
    selected = selected_entity_ids(payload.get("entities"), active)
    if not selected:
        return fail("Choose at least one air conditioner")
    if not active:
        active = selected[0]
    if active not in selected:
        selected.insert(0, active)
        selected = selected[:MAX_SELECTED_ENTITIES]
    config["entity_id"] = active
    config["selected_entities"] = selected
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the selected air conditioners: {exc}")
    if preference_enabled(config.get("shortcuts_enabled")):
        sync_hyprland_shortcuts(config)
    return emit({
        "ok": True,
        "entity_id": active,
        "selected_entities": selected,
    })


def set_preference(config: dict[str, Any], raw_name: str, raw_value: str) -> int:
    name = raw_name.strip().lower()
    value_text = raw_value.strip()
    if name == "advanced_controls":
        if value_text.lower() not in {"on", "off"}:
            return fail("Climate controls must be on or off")
        value: Any = value_text.lower() == "on"
        config[name] = value
    elif name == "master_switch_enabled":
        if value_text.lower() not in {"on", "off"}:
            return fail("MasterSwitch must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
    elif name == "temperature_display":
        value = temperature_display(value_text)
        if value_text.lower() not in {"ambient", "target", "both"}:
            return fail("Temperature display must be ambient, target, or both")
        config[name] = value
    elif name == "history_enabled":
        if value_text.lower() not in {"on", "off"}:
            return fail("Temperature history must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
    elif name == "history_source":
        if value_text.lower() not in {"local", "server"}:
            return fail("Temperature history source must be local or server")
        value = value_text.lower()
        config[name] = value
    elif name == "shortcuts_enabled":
        if value_text.lower() not in {"on", "off"}:
            return fail("Keyboard shortcuts must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
    elif name.startswith("shortcut_enabled_"):
        shortcut_name = name[len("shortcut_enabled_"):]
        if shortcut_name not in SHORTCUT_DEFAULTS:
            return fail("Unknown keyboard shortcut")
        if value_text.lower() not in {"on", "off"}:
            return fail("Keyboard shortcuts must be on or off")
        value = value_text.lower() == "on"
        shortcuts = shortcut_settings(config)
        shortcuts[shortcut_name]["enabled"] = value
        config["shortcuts"] = shortcuts
    elif name.startswith("shortcut_"):
        shortcut_name = name[len("shortcut_"):]
        if shortcut_name not in SHORTCUT_DEFAULTS:
            return fail("Unknown keyboard shortcut")
        value = normalize_shortcut(value_text)
        if not value:
            return fail(
                "Shortcut must contain one key, optionally with modifiers, such as SUPER+ALT+A"
            )
        shortcuts = shortcut_settings(config)
        shortcuts[shortcut_name]["key"] = value
        config["shortcuts"] = shortcuts
    elif name == "reset_shortcuts":
        value = True
        config["shortcuts"] = {
            shortcut_name: dict(default)
            for shortcut_name, default in SHORTCUT_DEFAULTS.items()
        }
    elif name == "reset_appearance":
        value = True
        config["appearance_auto_accent"] = True
        config["appearance_auto_background"] = True
        config["appearance_accent"] = DEFAULT_APPEARANCE_ACCENT
        config["appearance_control"] = DEFAULT_APPEARANCE_CONTROL
        config["appearance_background"] = DEFAULT_APPEARANCE_BACKGROUND
        config["appearance_device_colors_enabled"] = False
        config["appearance_device_colors"] = {}
        config["appearance_transparency"] = DEFAULT_APPEARANCE_TRANSPARENCY
        config["appearance_blur"] = DEFAULT_APPEARANCE_BLUR
        config["appearance_radius"] = DEFAULT_APPEARANCE_RADIUS
        config["appearance_compact"] = DEFAULT_APPEARANCE_COMPACT
    elif name == "temperature_unit":
        value = temperature_unit_preference(value_text)
        if value not in {"celsius", "fahrenheit", "kelvin"}:
            return fail("Temperature unit must be Celsius, Fahrenheit, or Kelvin")
        config[name] = value
    elif name in {
        "multi_unit_enabled", "global_sync_controls", "sync_non_power_controls",
        "average_temperature_decimals",
        "experimental_history_enabled",
        "custom_appearance_enabled", "appearance_auto_accent", "appearance_auto_background",
        "appearance_device_colors_enabled", "appearance_compact",
        "global_tab_navigation_enabled",
        "config_file_mode_enabled",
    }:
        if value_text.lower() not in {"on", "off"}:
            return fail(f"{name.replace('_', ' ').capitalize()} must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
        if name == "multi_unit_enabled" and value:
            config["selected_entities"] = selected_entity_ids(
                config.get("selected_entities"), config.get("entity_id")
            )
        if name == "experimental_history_enabled" and not value:
            config["history_hours"] = 24
            config["history_custom"] = False
    elif name == "bar_temperature_mode":
        if value_text.lower() not in {"average", "all", "selected"}:
            return fail("Bar temperature mode must be average, all, or selected")
        value = value_text.lower()
        config[name] = value
    elif name == "bar_temperature_entities":
        value = selected_entity_ids(value_text)
        if not value:
            value = selected_entity_ids(config.get("selected_entities"), config.get("entity_id"))
        config[name] = value
    elif name in {
        "appearance_accent", "appearance_control", "appearance_background",
        "appearance_device_colors",
        "appearance_transparency", "appearance_blur", "appearance_radius",
    }:
        if name in {"appearance_accent", "appearance_control", "appearance_background"}:
            if not APPEARANCE_HEX_PATTERN.fullmatch(value_text):
                return fail("Colour must be a six-digit hex value such as #8FA79F")
            value = value_text.upper()
        elif name == "appearance_device_colors":
            value = appearance_color_map(value_text)
            if value_text and not value and value_text not in {"{}", "null"}:
                return fail("Device colours must be a JSON object of climate IDs and hex colours")
        else:
            limits = {
                "appearance_transparency": (0, 100),
                "appearance_blur": (0, 24),
                "appearance_radius": (8, 32),
            }
            minimum, maximum = limits[name]
            try:
                parsed = float(value_text)
            except (TypeError, ValueError):
                return fail(f"{name.replace('_', ' ').capitalize()} must be between {minimum:g} and {maximum:g}")
            if parsed != parsed or not minimum <= parsed <= maximum:
                return fail(f"{name.replace('_', ' ').capitalize()} must be between {minimum:g} and {maximum:g}")
            value = round(parsed, 2)
        config[name] = value
    elif name == "history_range":
        is_extended_range = value_text.lower() in {"168", "720"} or value_text.lower().startswith("custom:")
        if is_extended_range and not preference_enabled(config.get("experimental_history_enabled")):
            return fail(
                "Enable Extended chart history in Experimental settings before choosing "
                "7-day, 30-day, or custom ranges"
            )
        if value_text.lower() in {"1", "3", "6", "12", "24", "168", "720"}:
            value = float(value_text)
            config["history_hours"] = int(value)
            config["history_custom"] = False
        elif value_text.lower().startswith("custom:"):
            try:
                value = float(value_text.split(":", 1)[1].strip())
            except (TypeError, ValueError):
                return fail(f"Custom history must be between 1 and {MAX_HISTORY_HOURS:g} hours")
            if value != value or not 1 <= value <= MAX_HISTORY_HOURS:
                return fail(f"Custom history must be between 1 and {MAX_HISTORY_HOURS:g} hours")
            value = round(value, 2)
            config["history_hours"] = value
            config["history_custom"] = True
        else:
            return fail("Choose 1, 3, 6, 12, 24, 168, 720, or a custom history range")
    else:
        return fail("Unknown preference")
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the AC configuration: {exc}")
    shortcut_sync_error = ""
    if (
        name == "shortcuts_enabled"
        or name == "multi_unit_enabled"
        or name == "global_sync_controls"
        or name == "reset_shortcuts"
        or name.startswith("shortcut_")
    ):
        shortcut_sync_error = sync_hyprland_shortcuts(config)
    response: dict[str, Any] = {"ok": True, "preference": name}
    if name == "history_range":
        response.update({
            "history_hours": config["history_hours"],
            "history_custom": config["history_custom"],
        })
    else:
        response["value"] = value
        if name == "experimental_history_enabled":
            response["history_hours"], response["history_custom"] = effective_history_settings(config)
        if name == "reset_appearance":
            response.update({
                "appearance_reset": True,
                **experimental_settings(config),
            })
    if (
        name == "shortcuts_enabled"
        or name == "reset_shortcuts"
        or name.startswith("shortcut_")
    ):
        response["shortcuts"] = shortcut_settings(config)
    if shortcut_sync_error:
        response["shortcut_sync_error"] = shortcut_sync_error
    return emit(response)


def set_advanced_controls(config: dict[str, Any], raw_value: str) -> int:
    """Backward-compatible alias for older local panel copies."""
    return set_preference(config, "advanced_controls", raw_value)


def main(argv: list[str]) -> int:
    action = argv[1] if len(argv) > 1 else "status"
    if action == "reset-app" and len(argv) == 2:
        return reset_app()
    if action == "remote-history-source" and len(argv) == 2:
        return remote_history_source()
    if action == "sync-shortcuts" and len(argv) == 2:
        try:
            config = load_config()
        except HomeAssistantError as exc:
            return fail(str(exc))
        sync_error = sync_hyprland_shortcuts(config)
        payload: dict[str, Any] = {"ok": True, "synced": sync_error == ""}
        if sync_error:
            payload["shortcut_sync_error"] = sync_error
        return emit(payload)
    try:
        config = load_config()
        if action == "set-config-file" and len(argv) == 2:
            try:
                return set_config_file(config, read_setup_payload())
            except HomeAssistantError as exc:
                return fail(str(exc))
        (
            url,
            token,
            entity_id,
            advanced_controls,
            master_switch_enabled,
            display,
            history_enabled,
            selected_history_hours,
            history_custom,
            selected_history_source,
            remote_target,
            remote_port,
            remote_url,
            remote_path,
        ) = config_values(config)
    except HomeAssistantError as exc:
        return fail(str(exc))

    if action == "config" and len(argv) == 2:
        return config_snapshot(
            url,
            token,
            entity_id,
            advanced_controls,
            master_switch_enabled,
            display,
            history_enabled,
            selected_history_hours,
            history_custom,
            selected_history_source,
            remote_target,
            remote_port,
            remote_url,
            remote_path,
            config,
        )
    if action == "configure" and len(argv) == 2:
        try:
            return configure(read_setup_payload(), config)
        except HomeAssistantError as exc:
            return fail(str(exc), configured=False, url=url)
    if action == "set-advanced-controls" and len(argv) == 3:
        return set_advanced_controls(config, argv[2])
    if action == "set-preference" and len(argv) == 4:
        return set_preference(config, argv[2], argv[3])
    if action == "set-selection" and len(argv) == 2:
        try:
            return set_selection(config, read_setup_payload())
        except HomeAssistantError as exc:
            return fail(str(exc))

    # Reconnecting to an already-installed external logger only needs the
    # SSH target. It must not be gated on the local Home Assistant token: the
    # connect action deliberately does not call Home Assistant or change the
    # remote host. Installation remains below the token check because it has
    # to write the token-bearing logger configuration remotely.
    if action == "connect-remote-history" and len(argv) == 2:
        try:
            return connect_remote_history(config, read_setup_payload())
        except HomeAssistantError as exc:
            return fail(str(exc), configured=bool(token), url=url)

    if not token:
        return fail(
            f"Add a Home Assistant long-lived access token to {CONFIG_PATH}",
            configured=False,
            url=url,
        )

    metadata = {"configured": True, "url": url, "entity_id": entity_id}
    try:
        if action == "entities" and len(argv) == 2:
            return emit({"ok": True, "entities": list_entities(url, token)})
        if action == "install-remote-history" and len(argv) == 2:
            return install_remote_history(config, read_setup_payload())
        if action == "status":
            return status(url, token, entity_id, config)
        if action == "set-entity" and len(argv) == 3:
            return set_entity(config, argv[2])
        if action == "set-temperature" and len(argv) in {3, 4}:
            return set_temperature(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-mode" and len(argv) in {3, 4}:
            return set_hvac_mode(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-fan-mode" and len(argv) in {3, 4}:
            return set_fan_mode(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-power" and len(argv) in {3, 4}:
            return set_power(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "turn-off-all" and len(argv) == 2:
            return turn_off_all(url, token)
        if action == "turn-on-all" and len(argv) == 2:
            return turn_on_all(url, token)
        return fail(
            "Usage: config | configure | entities | status | set-entity <entity_id> "
            "| set-selection | set-temperature <value> [entity_id] "
            "| set-mode <mode> [entity_id] | set-fan-mode <mode> [entity_id] "
            "| set-power <on|off> [entity_id] | turn-off-all | turn-on-all "
            "| connect-remote-history | install-remote-history | remote-history-source "
            "| set-preference <name> <value> | sync-shortcuts "
            "| reset-app"
        )
    except MultipleClimateEntitiesError as exc:
        return fail(str(exc), entity_ids=exc.entity_ids, **metadata)
    except HomeAssistantError as exc:
        return fail(str(exc), **metadata)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
