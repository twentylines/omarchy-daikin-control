def read_setup_payload() -> dict[str, Any]:
    """Read setup credentials from stdin so the token never appears in argv."""
    raw = sys.stdin.readline().strip()
    if not raw:
        raise HomeAssistantError("No Home Assistant setup details were received")
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise HomeAssistantError("Home Assistant setup details were not valid JSON") from exc
    if not isinstance(payload, dict):
        raise HomeAssistantError("Home Assistant setup details must be a JSON object")
    return payload


def save_config(config: dict[str, Any]) -> None:
    CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".home-assistant-ac.", dir=CONFIG_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump(config, handle, indent=2)
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, CONFIG_PATH)
        os.chmod(CONFIG_PATH, 0o600)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def configure(payload: dict[str, Any], current_config: dict[str, Any]) -> int:
    """Validate credentials, select an entity, and persist a working setup."""
    try:
        url = normalize_url(payload.get("url") or current_config.get("url") or DEFAULT_URL)
    except HomeAssistantError as exc:
        return fail(str(exc), configured=False)
    token = str(payload.get("token") or "").strip()
    if not token:
        return fail("Paste a Home Assistant long-lived access token to continue", configured=False, url=url)

    try:
        # /api/ is cheap and gives a clear authentication error before we ask
        # for the full state list.
        api_request(url, token, "GET", "/api/")
        entities = list_entities(url, token)
    except HomeAssistantError as exc:
        return fail(str(exc), configured=False, url=url)

    if not entities:
        return fail(
            "Home Assistant is reachable, but no available climate entity was found. "
            "Finish the Daikin integration first, then try again.",
            configured=False,
            url=url,
        )

    requested_entity = str(payload.get("entity_id") or "").strip()
    if requested_entity:
        matching = next((item for item in entities if item["id"] == requested_entity), None)
        if matching is None:
            return fail(
                "Choose an available air conditioner from the device list.",
                configured=False,
                url=url,
                entities=entities,
                needs_entity=True,
            )
        entity_id = requested_entity
    elif len(entities) == 1:
        entity_id = entities[0]["id"]
    else:
        return emit({
            "ok": True,
            "configured": False,
            "url": url,
            "entities": entities,
            "needs_entity": True,
        })

    available_ids = {str(item["id"]) for item in entities}
    previous_experimental = experimental_settings(current_config)
    if previous_experimental["multi_unit_enabled"]:
        selected_ids = [
            item for item in selected_entity_ids(current_config.get("selected_entities"), entity_id)
            if item in available_ids
        ]
        if entity_id not in selected_ids:
            selected_ids.insert(0, entity_id)
    else:
        selected_ids = [entity_id]

    config = {
        "url": url,
        "token": token,
        "entity_id": entity_id,
        "advanced_controls": preference_enabled(
            payload["advanced_controls"] if "advanced_controls" in payload
            else current_config.get("advanced_controls", True)
        ),
        "master_switch_enabled": preference_enabled(
            payload["master_switch_enabled"] if "master_switch_enabled" in payload
            else current_config.get("master_switch_enabled", False)
        ),
        "temperature_display": temperature_display(current_config.get("temperature_display")),
        "history_enabled": preference_enabled(current_config.get("history_enabled")),
        "history_hours": effective_history_settings(current_config)[0],
        "history_custom": effective_history_settings(current_config)[1],
        "history_source": history_source(current_config.get("history_source")),
        "history_remote_target": remote_history_target(current_config.get("history_remote_target")),
        "history_remote_port": remote_history_port(current_config.get("history_remote_port", 22)),
        "history_remote_url": normalize_url(
            current_config.get("history_remote_url") or REMOTE_HISTORY_DEFAULT_URL
        ),
        "history_remote_path": remote_history_path(current_config.get("history_remote_path")),
        "multi_unit_enabled": previous_experimental["multi_unit_enabled"],
        "global_sync_controls": previous_experimental["global_sync_controls"],
        "selected_entities": selected_ids,
        "bar_temperature_mode": previous_experimental["bar_temperature_mode"],
        "bar_temperature_entity": previous_experimental["bar_temperature_entity"],
        "bar_temperature_entities": previous_experimental["bar_temperature_entities"],
        "experimental_history_enabled": previous_experimental["experimental_history_enabled"],
        "custom_appearance_enabled": previous_experimental["custom_appearance_enabled"],
        "appearance_accent": previous_experimental["appearance_accent"],
        "appearance_transparency": previous_experimental["appearance_transparency"],
        "appearance_blur": previous_experimental["appearance_blur"],
        "appearance_radius": previous_experimental["appearance_radius"],
    }
    if current_config.get("poll_seconds") is not None:
        config["poll_seconds"] = current_config["poll_seconds"]
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the Home Assistant configuration: {exc}", configured=False, url=url)

    selected = next(item for item in entities if item["id"] == entity_id)
    return emit({
        "ok": True,
        "configured": True,
        "url": url,
        "entity_id": entity_id,
        "name": selected["name"],
        "entities": entities,
        "advanced_controls": config["advanced_controls"],
        "master_switch_enabled": config["master_switch_enabled"],
        "temperature_display": config["temperature_display"],
        "history_enabled": config["history_enabled"],
        "history_hours": config["history_hours"],
        "history_custom": config["history_custom"],
        "history_source": config["history_source"],
        "history_remote_target": config["history_remote_target"],
        "history_remote_port": config["history_remote_port"],
        "history_remote_url": config["history_remote_url"],
        "history_remote_path": config["history_remote_path"],
        **experimental_settings(config),
    })


def climate_device_info(attrs: dict[str, Any]) -> str:
    nested = attrs.get("device_info") if isinstance(attrs.get("device_info"), dict) else {}

    def first_text(*values: Any) -> str:
        for value in values:
            text = str(value or "").strip()
            if text:
                return text
        return ""

    manufacturer = first_text(
        attrs.get("manufacturer"), attrs.get("brand"), attrs.get("make"),
        nested.get("manufacturer"), nested.get("brand"), nested.get("make"),
    ) or "Daikin"
    model = first_text(
        attrs.get("model"), attrs.get("model_name"), attrs.get("model_id"), attrs.get("device_model"),
        nested.get("model"), nested.get("model_name"), nested.get("model_id"),
    )
    if not model or model.casefold() == manufacturer.casefold():
        return manufacturer
    if manufacturer.casefold() in model.casefold():
        return model
    return f"{manufacturer} ({model})"


def state_payload(state: dict[str, Any], entity_ids: list[str]) -> dict[str, Any]:
    attrs = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
    entity_id = str(state.get("entity_id") or entity_ids[0])
    modes = attrs.get("hvac_modes") if isinstance(attrs.get("hvac_modes"), list) else []
    fan_modes = attrs.get("fan_modes") if isinstance(attrs.get("fan_modes"), list) else []
    return {
        "ok": True,
        "entity_id": entity_id,
        "name": str(attrs.get("friendly_name") or entity_id),
        "device_info": climate_device_info(attrs),
        "state": str(state.get("state") or "unknown"),
        "ambient": number(attrs.get("current_temperature")),
        "target": number(attrs.get("temperature", attrs.get("target_temperature"))),
        "unit": temperature_unit(attrs.get("temperature_unit")),
        "step": number(attrs.get("target_temp_step")) or 1.0,
        "min_temp": number(attrs.get("min_temp")),
        "max_temp": number(attrs.get("max_temp")),
        "hvac_modes": [str(mode) for mode in modes],
        "fan_mode": str(attrs.get("fan_mode") or ""),
        "fan_modes": [str(mode) for mode in fan_modes],
        "history": [],
        "history_source": "local",
        "history_server": "",
        "history_error": "",
        "last_updated": state.get("last_updated"),
    }


def status(
    url: str,
    token: str,
    configured_entity: str,
    config: dict[str, Any] | None = None,
) -> int:
    active_entity = climate_entity_id(configured_entity)
    selected = configured_entity_ids(config or {}, configured_entity)
    if len(selected) > 1:
        states = resolve_states(url, token, selected)
        selected = [str(state.get("entity_id") or "") for state in states]
    else:
        state, resolved_ids = resolve_state(url, token, configured_entity)
        states = [state]
        selected = resolved_ids

    units = [state_payload(state, [str(state.get("entity_id") or selected[index])])
             for index, state in enumerate(states)]
    primary_index = next(
        (index for index, unit_payload in enumerate(units)
         if unit_payload["entity_id"] == active_entity),
        0,
    )
    if config is not None and history_source(config.get("history_source")) == "server":
        target = remote_history_target(config.get("history_remote_target"))
        server_name = remote_history_display_name(target) if target else "NOT CONFIGURED"
        try:
            remote_history = load_remote_temperature_history(config)
            for unit_payload in units:
                unit_payload["history_source"] = "server"
                unit_payload["history_server"] = server_name
                unit_payload["history"] = remote_history.get(unit_payload["entity_id"], [])
        except HomeAssistantError as exc:
            for unit_payload in units:
                unit_payload["history_source"] = "server"
                unit_payload["history_server"] = server_name
                unit_payload["history"] = []
                unit_payload["history_error"] = str(exc)
    else:
        for unit_payload in units:
            unit_payload["history"] = record_temperature_history(
                unit_payload["entity_id"], unit_payload.get("ambient"), unit_payload["unit"]
            )

    # Copy the primary payload before adding the aggregate metadata; otherwise
    # the top-level object would contain itself through `units`.
    payload = dict(units[primary_index])
    payload["units"] = units
    payload["selected_entities"] = selected
    payload["multi_unit_enabled"] = preference_enabled((config or {}).get("multi_unit_enabled"))
    payload["global_sync_controls"] = preference_enabled(
        (config or {}).get("global_sync_controls", True)
    )
    return emit(payload)


def call_service(url: str, token: str, service: str, data: dict[str, Any]) -> None:
    api_request(url, token, "POST", f"/api/services/climate/{service}", data)


def request_may_have_reached_home_assistant(error: HomeAssistantError) -> bool:
    message = str(error).lower()
    return any(marker in message for marker in ("timed out", "timeout", "cannot reach", "unreachable"))


def verify_all_power_state(url: str, token: str, expected_on: bool) -> list[str] | None:
    """Check state after a transport timeout without repeating the control call."""
    try:
        entities = list_entities(url, token)
    except HomeAssistantError:
        return None
    if not entities:
        return None
    if all((str(entity.get("state") or "").lower() != "off") == expected_on for entity in entities):
        return [str(entity["id"]) for entity in entities]
    return None


def action_states(
    url: str,
    token: str,
    configured_entity: str,
    target_entity_ids: list[str] | None,
) -> tuple[list[dict[str, Any]], list[str]]:
    if target_entity_ids is None:
        state, entity_ids = resolve_state(url, token, configured_entity)
        return [state], entity_ids
    requested_ids = selected_entity_ids(target_entity_ids, configured_entity)
    states = resolve_states(url, token, requested_ids)
    resolved_ids = [str(state.get("entity_id") or "") for state in states]
    return states, resolved_ids


def service_entity_value(entity_ids: list[str]) -> str | list[str]:
    return entity_ids[0] if len(entity_ids) == 1 else entity_ids


def set_temperature(
    url: str,
    token: str,
    configured_entity: str,
    raw_value: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    try:
        requested = float(raw_value)
    except ValueError:
        return fail("Target temperature must be a number")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    for payload in payloads:
        minimum = payload.get("min_temp")
        maximum = payload.get("max_temp")
        if minimum is not None and requested < minimum:
            return fail(f"Target temperature is below the device minimum ({minimum:g}{payload['unit']})")
        if maximum is not None and requested > maximum:
            return fail(f"Target temperature is above the device maximum ({maximum:g}{payload['unit']})")
    requested = round(requested, 2)
    call_service(url, token, "set_temperature", {
        "entity_id": service_entity_value(entity_ids),
        "temperature": requested,
    })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_target": requested,
    })


def set_entity(config: dict[str, Any], entity_id: str) -> int:
    entity_id = entity_id.strip()
    if not entity_id.startswith("climate.") or any(char.isspace() for char in entity_id):
        return fail("Entity ID must look like climate.room_name")
    config["entity_id"] = entity_id
    if preference_enabled(config.get("multi_unit_enabled")):
        selected = selected_entity_ids(config.get("selected_entities"), entity_id)
        if entity_id not in selected:
            selected.insert(0, entity_id)
        config["selected_entities"] = selected
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the AC configuration: {exc}")
    return emit({"ok": True, "entity_id": entity_id})


def set_power(
    url: str,
    token: str,
    configured_entity: str,
    requested_power: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested_power = requested_power.strip().lower()
    if requested_power not in {"on", "off"}:
        return fail("Power state must be on or off")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    target_modes: list[str] = []
    for payload in payloads:
        available_modes = [str(mode) for mode in payload["hvac_modes"]]
        modes = {mode.casefold(): mode for mode in available_modes}
        if requested_power == "on":
            preferred = next(
                (modes[mode] for mode in ("cool", "auto", "heat", "dry", "fan_only") if mode in modes),
                None,
            )
            if preferred is None:
                preferred = next((mode for mode in available_modes if mode.casefold() != "off"), None)
            if preferred is None:
                return fail("The climate entity has no mode available for powering on")
            target_modes.append(preferred)
        else:
            target_modes.append("off")
    if len(set(mode.casefold() for mode in target_modes)) == 1:
        call_service(url, token, "set_hvac_mode", {
            "entity_id": service_entity_value(entity_ids),
            "hvac_mode": target_modes[0],
        })
    else:
        for entity_id, target_mode in zip(entity_ids, target_modes):
            call_service(url, token, "set_hvac_mode", {
                "entity_id": entity_id,
                "hvac_mode": target_mode,
            })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_mode": target_modes[0] if len(set(target_modes)) == 1 else target_modes,
    })


def set_hvac_mode(
    url: str,
    token: str,
    configured_entity: str,
    raw_mode: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested = raw_mode.strip()
    if not requested:
        return fail("Choose a climate mode")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    selected_modes: list[str] = []
    for payload in payloads:
        available = [str(mode) for mode in payload["hvac_modes"]]
        selected = next((mode for mode in available if mode.casefold() == requested.casefold()), None)
        if selected is None:
            return fail("That climate mode is not available for every selected air conditioner")
        selected_modes.append(selected)
    selected = selected_modes[0]
    call_service(url, token, "set_hvac_mode", {
        "entity_id": service_entity_value(entity_ids),
        "hvac_mode": selected,
    })
    restarting = selected.casefold() != "off"
    if restarting:
        call_service(url, token, "turn_on", {"entity_id": service_entity_value(entity_ids)})
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_mode": selected,
        "restarting": restarting,
    })


def set_fan_mode(
    url: str,
    token: str,
    configured_entity: str,
    raw_mode: str,
    target_entity_ids: list[str] | None = None,
) -> int:
    requested = raw_mode.strip()
    if not requested:
        return fail("Choose a fan speed")
    states, entity_ids = action_states(url, token, configured_entity, target_entity_ids)
    payloads = [state_payload(state, [entity_ids[index]]) for index, state in enumerate(states)]
    selected_modes: list[str] = []
    for payload in payloads:
        available = [str(mode) for mode in payload["fan_modes"]]
        selected = next((mode for mode in available if mode.casefold() == requested.casefold()), None)
        if selected is None:
            if available:
                return fail("That fan speed is not available for every selected air conditioner")
            return fail("The selected air conditioner does not expose fan-speed controls")
        selected_modes.append(selected)
    selected = selected_modes[0]
    call_service(url, token, "set_fan_mode", {
        "entity_id": service_entity_value(entity_ids),
        "fan_mode": selected,
    })
    return emit({
        "ok": True,
        "entity_id": configured_entity,
        "entity_ids": entity_ids,
        "requested_fan_mode": selected,
    })


def reset_app() -> int:
    """Remove only Daikin Air's saved connection, preferences, and history."""
    removed: list[str] = []
    for path in (CONFIG_PATH, HISTORY_PATH):
        try:
            path.unlink()
        except FileNotFoundError:
            continue
        except OSError as exc:
            return fail(f"Cannot reset Daikin Air data at {path}: {exc}")
        removed.append(str(path))
    return emit({"ok": True, "reset": True, "removed": removed})


def set_selection(config: dict[str, Any], payload: dict[str, Any]) -> int:
    """Persist the visible multi-aircon list and its active entity."""
    active = climate_entity_id(payload.get("entity_id") or config.get("entity_id"))
    selected = selected_entity_ids(payload.get("entities"), active)
    if not selected:
        return fail("Choose at least one air conditioner")
    if not active:
        active = selected[0]
    if active not in selected:
        selected.insert(0, active)
        selected = selected[:MAX_SELECTED_ENTITIES]
    config["entity_id"] = active
    config["selected_entities"] = selected
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the selected air conditioners: {exc}")
    return emit({
        "ok": True,
        "entity_id": active,
        "selected_entities": selected,
    })


def set_preference(config: dict[str, Any], raw_name: str, raw_value: str) -> int:
    name = raw_name.strip().lower()
    value_text = raw_value.strip()
    if name == "advanced_controls":
        if value_text.lower() not in {"on", "off"}:
            return fail("Climate controls must be on or off")
        value: Any = value_text.lower() == "on"
        config[name] = value
    elif name == "master_switch_enabled":
        if value_text.lower() not in {"on", "off"}:
            return fail("MasterSwitch must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
    elif name == "temperature_display":
        value = temperature_display(value_text)
        if value_text.lower() not in {"ambient", "target", "both"}:
            return fail("Temperature display must be ambient, target, or both")
        config[name] = value
    elif name == "history_enabled":
        if value_text.lower() not in {"on", "off"}:
            return fail("Temperature history must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
    elif name == "history_source":
        if value_text.lower() not in {"local", "server"}:
            return fail("Temperature history source must be local or server")
        value = value_text.lower()
        config[name] = value
    elif name in {"multi_unit_enabled", "global_sync_controls", "experimental_history_enabled", "custom_appearance_enabled"}:
        if value_text.lower() not in {"on", "off"}:
            return fail(f"{name.replace('_', ' ').capitalize()} must be on or off")
        value = value_text.lower() == "on"
        config[name] = value
        if name == "multi_unit_enabled" and value:
            config["selected_entities"] = selected_entity_ids(
                config.get("selected_entities"), config.get("entity_id")
            )
        if name == "experimental_history_enabled" and not value:
            config["history_hours"] = 24
            config["history_custom"] = False
    elif name == "bar_temperature_mode":
        if value_text.lower() not in {"average", "all", "single", "selected"}:
            return fail("Bar temperature mode must be average, all, single, or selected")
        value = value_text.lower()
        config[name] = value
    elif name == "bar_temperature_entity":
        value = climate_entity_id(value_text)
        if value_text and not value:
            return fail("The bar temperature entity must look like climate.room_name")
        config[name] = value
    elif name == "bar_temperature_entities":
        value = selected_entity_ids(value_text)
        if not value:
            value = selected_entity_ids(config.get("selected_entities"), config.get("entity_id"))
        config[name] = value
    elif name in {"appearance_accent", "appearance_transparency", "appearance_blur", "appearance_radius"}:
        if name == "appearance_accent":
            if not APPEARANCE_HEX_PATTERN.fullmatch(value_text):
                return fail("Accent color must be a six-digit hex value such as #8FA79F")
            value = value_text.upper()
        else:
            limits = {
                "appearance_transparency": (0, 70),
                "appearance_blur": (0, 24),
                "appearance_radius": (8, 32),
            }
            minimum, maximum = limits[name]
            try:
                parsed = float(value_text)
            except (TypeError, ValueError):
                return fail(f"{name.replace('_', ' ').capitalize()} must be between {minimum:g} and {maximum:g}")
            if parsed != parsed or not minimum <= parsed <= maximum:
                return fail(f"{name.replace('_', ' ').capitalize()} must be between {minimum:g} and {maximum:g}")
            value = round(parsed, 2)
        config[name] = value
    elif name == "history_range":
        is_extended_range = value_text.lower() in {"168", "720"} or value_text.lower().startswith("custom:")
        if is_extended_range and not preference_enabled(config.get("experimental_history_enabled")):
            return fail(
                "Enable Extended chart history in Experimental settings before choosing "
                "7-day, 30-day, or custom ranges"
            )
        if value_text.lower() in {"1", "3", "6", "12", "24", "168", "720"}:
            value = float(value_text)
            config["history_hours"] = int(value)
            config["history_custom"] = False
        elif value_text.lower().startswith("custom:"):
            try:
                value = float(value_text.split(":", 1)[1].strip())
            except (TypeError, ValueError):
                return fail(f"Custom history must be between 1 and {MAX_HISTORY_HOURS:g} hours")
            if value != value or not 1 <= value <= MAX_HISTORY_HOURS:
                return fail(f"Custom history must be between 1 and {MAX_HISTORY_HOURS:g} hours")
            value = round(value, 2)
            config["history_hours"] = value
            config["history_custom"] = True
        else:
            return fail("Choose 1, 3, 6, 12, 24, 168, 720, or a custom history range")
    else:
        return fail("Unknown preference")
    try:
        save_config(config)
    except OSError as exc:
        return fail(f"Cannot save the AC configuration: {exc}")
    response: dict[str, Any] = {"ok": True, "preference": name}
    if name == "history_range":
        response.update({
            "history_hours": config["history_hours"],
            "history_custom": config["history_custom"],
        })
    else:
        response["value"] = value
        if name == "experimental_history_enabled":
            response["history_hours"], response["history_custom"] = effective_history_settings(config)
    return emit(response)


def set_advanced_controls(config: dict[str, Any], raw_value: str) -> int:
    """Backward-compatible alias for older local panel copies."""
    return set_preference(config, "advanced_controls", raw_value)


def main(argv: list[str]) -> int:
    action = argv[1] if len(argv) > 1 else "status"
    if action == "reset-app" and len(argv) == 2:
        return reset_app()
    if action == "remote-history-source" and len(argv) == 2:
        return remote_history_source()
    try:
        config = load_config()
        (
            url,
            token,
            entity_id,
            advanced_controls,
            master_switch_enabled,
            display,
            history_enabled,
            selected_history_hours,
            history_custom,
            selected_history_source,
            remote_target,
            remote_port,
            remote_url,
            remote_path,
        ) = config_values(config)
    except HomeAssistantError as exc:
        return fail(str(exc))

    if action == "config" and len(argv) == 2:
        return config_snapshot(
            url,
            token,
            entity_id,
            advanced_controls,
            master_switch_enabled,
            display,
            history_enabled,
            selected_history_hours,
            history_custom,
            selected_history_source,
            remote_target,
            remote_port,
            remote_url,
            remote_path,
            config,
        )
    if action == "configure" and len(argv) == 2:
        try:
            return configure(read_setup_payload(), config)
        except HomeAssistantError as exc:
            return fail(str(exc), configured=False, url=url)
    if action == "set-advanced-controls" and len(argv) == 3:
        return set_advanced_controls(config, argv[2])
    if action == "set-preference" and len(argv) == 4:
        return set_preference(config, argv[2], argv[3])
    if action == "set-selection" and len(argv) == 2:
        try:
            return set_selection(config, read_setup_payload())
        except HomeAssistantError as exc:
            return fail(str(exc))
    if not token:
        return fail(
            f"Add a Home Assistant long-lived access token to {CONFIG_PATH}",
            configured=False,
            url=url,
        )

    metadata = {"configured": True, "url": url, "entity_id": entity_id}
    try:
        if action == "entities" and len(argv) == 2:
            return emit({"ok": True, "entities": list_entities(url, token)})
        if action == "install-remote-history" and len(argv) == 2:
            return install_remote_history(config, read_setup_payload())
        if action == "status":
            return status(url, token, entity_id, config)
        if action == "set-entity" and len(argv) == 3:
            return set_entity(config, argv[2])
        if action == "set-temperature" and len(argv) in {3, 4}:
            return set_temperature(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-mode" and len(argv) in {3, 4}:
            return set_hvac_mode(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-fan-mode" and len(argv) in {3, 4}:
            return set_fan_mode(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "set-power" and len(argv) in {3, 4}:
            return set_power(
                url, token, entity_id, argv[2],
                control_entity_ids(config, entity_id, argv[3] if len(argv) == 4 else None),
            )
        if action == "turn-off-all" and len(argv) == 2:
            return turn_off_all(url, token)
        if action == "turn-on-all" and len(argv) == 2:
            return turn_on_all(url, token)
        return fail(
            "Usage: config | configure | entities | status | set-entity <entity_id> "
            "| set-selection | set-temperature <value> [entity_id] "
            "| set-mode <mode> [entity_id] | set-fan-mode <mode> [entity_id] "
            "| set-power <on|off> [entity_id] | turn-off-all | turn-on-all "
            "| install-remote-history | remote-history-source "
            "| set-preference <name> <value> "
            "| reset-app"
        )
    except MultipleClimateEntitiesError as exc:
        return fail(str(exc), entity_ids=exc.entity_ids, **metadata)
    except HomeAssistantError as exc:
        return fail(str(exc), **metadata)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
