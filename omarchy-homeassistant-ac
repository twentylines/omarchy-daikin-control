#!/usr/bin/env python3
"""Small Home Assistant client for the Omarchy AC bar widget.

The access token stays in the user-owned JSON config and is never printed.
"""

from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.parse import quote, urlsplit, urlunsplit
from urllib.request import Request, urlopen


DEFAULT_URL = "http://homeassistant.local:8123"
CONFIG_PATH = (
    Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
    / "omarchy/home-assistant-ac.json"
)
HISTORY_PATH = (
    Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state")))
    / "omarchy/home-assistant-ac-temperature.json"
)
MAX_HISTORY_HOURS = 31 * 24
HISTORY_RETENTION_SECONDS = MAX_HISTORY_HOURS * 60 * 60
HISTORY_MAX_SAMPLES = 50_000
MAX_SELECTED_ENTITIES = 12
CLIMATE_ENTITY_PATTERN = re.compile(r"^climate\.[A-Za-z0-9_-]+$")
APPEARANCE_HEX_PATTERN = re.compile(r"^#[0-9A-Fa-f]{6}$")
DEFAULT_APPEARANCE_ACCENT = "#8FA79F"
DEFAULT_APPEARANCE_TRANSPARENCY = 0
DEFAULT_APPEARANCE_BLUR = 0
DEFAULT_APPEARANCE_RADIUS = 16
REMOTE_HISTORY_DEFAULT_URL = "http://127.0.0.1:8123"
REMOTE_HISTORY_DEFAULT_PATH = "~/.local/state/omarchy/homeassistant-ac-temperature.json"
REMOTE_HISTORY_TARGET_PATTERN = re.compile(r"^[A-Za-z0-9_.:@\-\[\]]+$")
REMOTE_HISTORY_PATH_PATTERN = re.compile(r"^[A-Za-z0-9_./~\-]+$")
REMOTE_HISTORY_IDENTITY_PATH = Path.home() / ".ssh/omarchy-homeassistant-ac"


class HomeAssistantError(RuntimeError):
    pass


class MultipleClimateEntitiesError(HomeAssistantError):
    def __init__(self, entity_ids: list[str]) -> None:
        self.entity_ids = entity_ids
        super().__init__("Multiple air conditioners found; choose one from the device list")


def emit(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, separators=(",", ":")))
    return 0 if payload.get("ok") else 1


def fail(message: str, **extra: Any) -> int:
    payload: dict[str, Any] = {"ok": False, "error": message}
    payload.update(extra)
    return emit(payload)


def load_config() -> dict[str, Any]:
    try:
        with CONFIG_PATH.open(encoding="utf-8") as handle:
            value = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as exc:
        raise HomeAssistantError(f"Cannot read {CONFIG_PATH}: {exc}") from exc
    if not isinstance(value, dict):
        raise HomeAssistantError(f"{CONFIG_PATH} must contain a JSON object")
    return value


def preference_enabled(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"1", "true", "on", "yes"}


def temperature_display(value: Any) -> str:
    text = str(value or "").strip().lower()
    return text if text in {"ambient", "target", "both"} else "both"


def history_hours(value: Any) -> float:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return 24
    if parsed != parsed or not 1 <= parsed <= MAX_HISTORY_HOURS:
        return 24
    return round(parsed, 2)


def effective_history_settings(config: dict[str, Any]) -> tuple[float, bool]:
    """Keep extended and custom ranges unavailable until the experiment is enabled."""
    extended = preference_enabled(config.get("experimental_history_enabled"))
    selected = history_hours(config.get("history_hours"))
    custom = preference_enabled(config.get("history_custom"))
    if not extended:
        return min(selected, 24), False
    return selected, custom


def climate_entity_id(value: Any) -> str:
    text = str(value or "").strip()
    return text if CLIMATE_ENTITY_PATTERN.fullmatch(text) else ""


def selected_entity_ids(value: Any, fallback: Any = "") -> list[str]:
    """Normalize the selected climate list while keeping old single-entity configs valid."""
    raw_items: list[Any]
    if isinstance(value, (list, tuple)):
        raw_items = list(value)
    elif value is None or str(value).strip() == "":
        raw_items = []
    else:
        raw_items = str(value).split(",")
    result: list[str] = []
    for item in raw_items:
        entity_id = climate_entity_id(item)
        if not entity_id or entity_id in result:
            continue
        result.append(entity_id)
        if len(result) >= MAX_SELECTED_ENTITIES:
            break
    fallback_id = climate_entity_id(fallback)
    if not result and fallback_id:
        result.append(fallback_id)
    return result


def bar_temperature_mode(value: Any) -> str:
    text = str(value or "").strip().lower()
    return text if text in {"average", "all", "single", "selected"} else "average"


def bounded_preference(value: Any, minimum: float, maximum: float, default: float) -> float:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return default
    if parsed != parsed:
        return default
    return round(max(minimum, min(maximum, parsed)), 2)


def appearance_hex(value: Any) -> str:
    text = str(value or "").strip()
    return text.upper() if APPEARANCE_HEX_PATTERN.fullmatch(text) else DEFAULT_APPEARANCE_ACCENT


def experimental_settings(config: dict[str, Any]) -> dict[str, Any]:
    selected = selected_entity_ids(config.get("selected_entities"), config.get("entity_id"))
    display_entities = selected_entity_ids(config.get("bar_temperature_entities"), selected)
    single_entity = climate_entity_id(config.get("bar_temperature_entity"))
    return {
        "multi_unit_enabled": preference_enabled(config.get("multi_unit_enabled")),
        "global_sync_controls": preference_enabled(config.get("global_sync_controls", True)),
        "selected_entities": selected,
        "bar_temperature_mode": bar_temperature_mode(config.get("bar_temperature_mode")),
        "bar_temperature_entity": single_entity,
        "bar_temperature_entities": display_entities,
        "experimental_history_enabled": preference_enabled(config.get("experimental_history_enabled")),
        "custom_appearance_enabled": preference_enabled(config.get("custom_appearance_enabled")),
        "appearance_accent": appearance_hex(config.get("appearance_accent")),
        "appearance_transparency": bounded_preference(
            config.get("appearance_transparency"), 0, 70, DEFAULT_APPEARANCE_TRANSPARENCY
        ),
        "appearance_blur": bounded_preference(
            config.get("appearance_blur"), 0, 24, DEFAULT_APPEARANCE_BLUR
        ),
        "appearance_radius": bounded_preference(
            config.get("appearance_radius"), 8, 32, DEFAULT_APPEARANCE_RADIUS
        ),
    }


def history_source(value: Any) -> str:
    return "server" if str(value or "").strip().lower() == "server" else "local"


def remote_history_target(value: Any, required: bool = False) -> str:
    text = str(value or "").strip()
    if not text:
        if required:
            raise HomeAssistantError("Enter the SSH target for the Home Assistant host, such as sai@192.168.1.20")
        return ""
    if not REMOTE_HISTORY_TARGET_PATTERN.fullmatch(text) or text.count("@") > 1:
        raise HomeAssistantError("SSH target may contain only a user@host address")
    return text


def remote_history_port(value: Any) -> int:
    try:
        port = int(str(value or "22").strip())
    except (TypeError, ValueError) as exc:
        raise HomeAssistantError("SSH port must be a number between 1 and 65535") from exc
    if not 1 <= port <= 65535:
        raise HomeAssistantError("SSH port must be a number between 1 and 65535")
    return port


def remote_history_path(value: Any) -> str:
    text = str(value or REMOTE_HISTORY_DEFAULT_PATH).strip()
    if (
        not text
        or not text.startswith(("/", "~/"))
        or not REMOTE_HISTORY_PATH_PATTERN.fullmatch(text)
        or ".." in text
    ):
        raise HomeAssistantError("The server history path is invalid")
    return text


def remote_history_settings(config: dict[str, Any]) -> tuple[str, int, str, str]:
    return (
        remote_history_target(config.get("history_remote_target")),
        remote_history_port(config.get("history_remote_port", 22)),
        normalize_url(config.get("history_remote_url") or REMOTE_HISTORY_DEFAULT_URL),
        remote_history_path(config.get("history_remote_path")),
    )


def config_values(config: dict[str, Any]) -> tuple[
    str, str, str, bool, bool, str, bool, float, bool, str, str, int, str, str
]:
    url = normalize_url(config.get("url") or os.environ.get("HOME_ASSISTANT_URL") or DEFAULT_URL)
    token = str(config.get("token") or os.environ.get("HOME_ASSISTANT_TOKEN") or "").strip()
    entity_id = str(config.get("entity_id") or "").strip()
    advanced_controls = preference_enabled(config.get("advanced_controls", True))
    master_switch_enabled = preference_enabled(config.get("master_switch_enabled"))
    display = temperature_display(config.get("temperature_display"))
    history_enabled = preference_enabled(config.get("history_enabled"))
    selected_history_hours, history_custom = effective_history_settings(config)
    selected_history_source = history_source(config.get("history_source"))
    remote_target, remote_port, remote_url, remote_path = remote_history_settings(config)
    return (
        url,
        token,
        entity_id,
        advanced_controls,
        master_switch_enabled,
        display,
        history_enabled,
        selected_history_hours,
        history_custom,
        selected_history_source,
        remote_target,
        remote_port,
        remote_url,
        remote_path,
    )


def normalize_url(value: Any) -> str:
    """Return a safe Home Assistant base URL from a friendly user input."""
    text = str(value or "").strip()
    if not text:
        raise HomeAssistantError("Enter the address of your Home Assistant server")
    if any(char.isspace() for char in text):
        raise HomeAssistantError("The Home Assistant address cannot contain spaces")
    if "://" not in text:
        text = f"http://{text}"
    try:
        parsed = urlsplit(text)
        port = parsed.port
    except ValueError as exc:
        raise HomeAssistantError("Enter a valid Home Assistant address and port") from exc
    if parsed.scheme.lower() not in {"http", "https"} or not parsed.netloc or not parsed.hostname:
        raise HomeAssistantError("Use an address such as http://homeassistant.local:8123")
    if parsed.username or parsed.password:
        raise HomeAssistantError("Do not include a username or password in the server address")
    if port is not None and not 1 <= port <= 65535:
        raise HomeAssistantError("The Home Assistant port must be between 1 and 65535")
    if parsed.query or parsed.fragment:
        raise HomeAssistantError("The Home Assistant address must not contain a query or fragment")
    path = parsed.path.rstrip("/")
    if path.lower().endswith("/api"):
        path = path[:-4].rstrip("/")
    return urlunsplit((parsed.scheme.lower(), parsed.netloc, path, "", "")).rstrip("/")


def api_request(url: str, token: str, method: str, path: str, body: dict[str, Any] | None = None) -> Any:
    headers = {
        "Accept": "application/json",
        "Authorization": f"Bearer {token}",
    }
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode("utf-8")
    request = Request(url + path, data=data, headers=headers, method=method)
    try:
        with urlopen(request, timeout=6) as response:
            raw = response.read()
    except HTTPError as exc:
        if exc.code == 401:
            raise HomeAssistantError("Home Assistant rejected the access token (401)") from exc
        if exc.code == 404:
            raise HomeAssistantError("Home Assistant endpoint or entity was not found (404)") from exc
        raise HomeAssistantError(f"Home Assistant returned HTTP {exc.code}") from exc
    except URLError as exc:
        raise HomeAssistantError(f"Cannot reach Home Assistant at {url}: {exc.reason}") from exc
    except TimeoutError as exc:
        raise HomeAssistantError(f"Home Assistant request timed out at {url}") from exc
    except OSError as exc:
        raise HomeAssistantError(f"Cannot reach Home Assistant at {url}") from exc
    if not raw:
        return None
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise HomeAssistantError("Home Assistant returned invalid JSON") from exc


def number(value: Any) -> float | None:
    try:
        result = float(value)
    except (TypeError, ValueError):
        return None
    return result if result == result else None


def temperature_unit(value: Any) -> str:
    text = str(value or "°C").strip()
    if text in {"C", "c"}:
        return "°C"
    if text in {"F", "f"}:
        return "°F"
    return text if text.startswith("°") else f"°{text}"


def clean_temperature_history(raw: Any) -> dict[str, list[dict[str, Any]]]:
    """Keep only the safe, timestamped sample shape the chart understands."""
    if not isinstance(raw, dict):
        return {}

    entities = raw.get("entities", raw)
    if not isinstance(entities, dict):
        return {}
    cleaned: dict[str, list[dict[str, Any]]] = {}
    for entity_id, samples in entities.items():
        if not isinstance(entity_id, str) or not entity_id.startswith("climate."):
            continue
        if not isinstance(samples, list):
            continue
        valid: list[dict[str, Any]] = []
        for sample in samples:
            if not isinstance(sample, dict):
                continue
            timestamp = number(sample.get("timestamp"))
            value = number(sample.get("temperature"))
            if timestamp is None or value is None:
                continue
            valid.append({
                "timestamp": int(timestamp),
                "temperature": value,
                "unit": temperature_unit(sample.get("unit")),
            })
        if valid:
            cleaned[entity_id] = valid[-HISTORY_MAX_SAMPLES:]
    return cleaned


def load_temperature_history() -> dict[str, list[dict[str, Any]]]:
    """Read best-effort local ambient samples without affecting live control."""
    try:
        with HISTORY_PATH.open(encoding="utf-8") as handle:
            raw = json.load(handle)
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return {}
    return clean_temperature_history(raw)


def save_temperature_history(history: dict[str, list[dict[str, Any]]]) -> None:
    HISTORY_PATH.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".home-assistant-ac-temperature.", dir=HISTORY_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"version": 1, "entities": history}, handle, separators=(",", ":"))
            handle.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, HISTORY_PATH)
        os.chmod(HISTORY_PATH, 0o600)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def prune_temperature_history(
    history: dict[str, list[dict[str, Any]]], now: float
) -> dict[str, list[dict[str, Any]]]:
    cutoff = now - HISTORY_RETENTION_SECONDS
    pruned: dict[str, list[dict[str, Any]]] = {}
    for entity_id, samples in history.items():
        recent = [
            sample for sample in samples
            if cutoff <= float(sample["timestamp"]) <= now + 300
        ]
        if recent:
            pruned[entity_id] = recent[-HISTORY_MAX_SAMPLES:]
    return pruned


def record_temperature_history(entity_id: str, value: Any, unit: str) -> list[dict[str, Any]]:
    """Append one ambient reading and retain exactly the latest 24 hours."""
    history = prune_temperature_history(load_temperature_history(), time.time())
    numeric_value = number(value)
    entity_id = str(entity_id or "").strip()
    if not entity_id or numeric_value is None:
        return history.get(entity_id, [])

    now = time.time()
    samples = history.setdefault(entity_id, [])
    sample = {
        "timestamp": int(now),
        "temperature": numeric_value,
        "unit": temperature_unit(unit),
    }
    if samples and int(samples[-1]["timestamp"]) >= int(now) - 15:
        samples[-1] = sample
    else:
        samples.append(sample)
    history = prune_temperature_history(history, now)
    try:
        save_temperature_history(history)
    except OSError:
        # A read-only or unavailable state directory must not break status.
        pass
    return history.get(entity_id, [])


def remote_history_display_name(target: str) -> str:
    return target.rsplit("@", 1)[-1] if "@" in target else target


def remote_history_identity_args() -> list[str]:
    if REMOTE_HISTORY_IDENTITY_PATH.is_file():
        return [
            "-i",
            str(REMOTE_HISTORY_IDENTITY_PATH),
            "-o",
            "IdentitiesOnly=yes",
        ]
    return []


def remote_history_ssh_command(target: str, port: int) -> list[str]:
    return [
        "ssh",
        "-T",
        *remote_history_identity_args(),
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=8",
        "-o",
        "ServerAliveInterval=5",
        "-o",
        "ServerAliveCountMax=1",
        "-p",
        str(port),
        target,
    ]


def remote_history_command_error(result: subprocess.CompletedProcess[str]) -> str:
    detail = (result.stderr or result.stdout or "").strip().splitlines()
    first_line = detail[0].strip() if detail else "SSH returned an error"
    lowered = first_line.lower()
    if "batchmode" in lowered or "password" in lowered or "publickey" in lowered:
        return "SSH key setup is incomplete. Open GUIDE and create the dedicated plugin key, then try again."
    if "could not resolve hostname" in lowered:
        return "The server address could not be resolved over SSH."
    return "Cannot read server history over SSH: " + first_line[:180]


def load_remote_temperature_history(config: dict[str, Any]) -> dict[str, list[dict[str, Any]]]:
    target, port, _url, path = remote_history_settings(config)
    if not target:
        raise HomeAssistantError("Server history is not configured. Add an SSH target in Settings.")
    command = remote_history_ssh_command(target, port) + ["cat", "--", path]
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=10,
            check=False,
        )
    except FileNotFoundError as exc:
        raise HomeAssistantError("SSH is not installed on this PC, so server history cannot be read.") from exc
    except subprocess.TimeoutExpired as exc:
        raise HomeAssistantError("Timed out while reading server history over SSH.") from exc
    except OSError as exc:
        raise HomeAssistantError(f"Cannot read server history over SSH: {exc}") from exc
    if result.returncode != 0:
        raise HomeAssistantError(remote_history_command_error(result))
    try:
        raw = json.loads(result.stdout or "{}")
    except json.JSONDecodeError as exc:
        raise HomeAssistantError("The server history file is not valid JSON yet.") from exc
    return clean_temperature_history(raw)


def remote_history_source() -> int:
    plugin_dir = Path(__file__).resolve().parent
    try:
        installer_source = (plugin_dir / "install-remote-history.sh").read_text(encoding="utf-8")
        logger_source = (plugin_dir / "remote-history-logger.py").read_text(encoding="utf-8")
        remote_uninstaller_source = (plugin_dir / "uninstall-remote-history.sh").read_text(encoding="utf-8")
        local_uninstaller_source = (plugin_dir / "uninstall-local-homeassistant.sh").read_text(encoding="utf-8")
        plugin_uninstaller_source = (plugin_dir / "uninstall-plugin.sh").read_text(encoding="utf-8")
    except OSError as exc:
        return fail(f"The server history source is incomplete: {exc}")
    source = f"""--- install-remote-history.sh ---
{installer_source}

--- remote-history-logger.py ---
{logger_source}

--- uninstall-remote-history.sh ---
{remote_uninstaller_source}

--- uninstall-local-homeassistant.sh ---
{local_uninstaller_source}

--- uninstall-plugin.sh ---
{plugin_uninstaller_source}
"""
    return emit({"ok": True, "source": source})


def install_remote_history(config: dict[str, Any], payload: dict[str, Any]) -> int:
    target = remote_history_target(payload.get("ssh_target"), required=True)
    port = remote_history_port(payload.get("ssh_port", 22))
    remote_url = normalize_url(payload.get("home_assistant_url") or REMOTE_HISTORY_DEFAULT_URL)
    path = remote_history_path(payload.get("history_path"))
    entity_id = climate_entity_id(payload.get("entity_id") or config.get("entity_id"))
    entity_ids = selected_entity_ids(payload.get("entity_ids"), entity_id)
    token = str(config.get("token") or "").strip()
    if not token:
        raise HomeAssistantError("Connect Home Assistant before installing server history.")
    if not entity_id or not entity_ids:
        raise HomeAssistantError("Choose an air conditioner before installing server history.")

    plugin_dir = Path(__file__).resolve().parent
    try:
        logger_source = (plugin_dir / "remote-history-logger.py").read_text(encoding="utf-8")
        installer_source = (plugin_dir / "install-remote-history.sh").read_text(encoding="utf-8")
    except OSError as exc:
        raise HomeAssistantError(f"The server history installer is incomplete: {exc}") from exc

    def run_ssh(command: list[str], *, input_text: str | None = None, timeout: int = 20) -> subprocess.CompletedProcess[str]:
        try:
            return subprocess.run(
                command,
                input=input_text,
                capture_output=True,
                text=True,
                timeout=timeout,
                check=False,
            )
        except FileNotFoundError as exc:
            raise HomeAssistantError("SSH and SCP are required on this PC. Install OpenSSH, then try again.") from exc
        except subprocess.TimeoutExpired as exc:
            raise HomeAssistantError("Timed out while installing the server history timer.") from exc
        except OSError as exc:
            raise HomeAssistantError(f"Cannot install server history over SSH: {exc}") from exc

    prepare_script = """set -eu
umask 077
mkdir -p "$HOME/.local/bin" "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
"""
    result = run_ssh(remote_history_ssh_command(target, port) + ["bash", "-s"], input_text=prepare_script)
    if result.returncode != 0:
        raise HomeAssistantError(remote_history_command_error(result))

    scp_options = [
        "scp",
        "-q",
        *remote_history_identity_args(),
        "-o",
        "BatchMode=yes",
        "-o",
        "ConnectTimeout=8",
        "-P",
        str(port),
    ]
    for source_name, destination_name in (
        ("remote-history-logger.py", ".local/bin/omarchy-homeassistant-ac-history.py"),
        ("install-remote-history.sh", ".local/bin/install-omarchy-homeassistant-ac-history.sh"),
    ):
        result = run_ssh(
            scp_options + [str(plugin_dir / source_name), f"{target}:{destination_name}"],
            timeout=25,
        )
        if result.returncode != 0:
            raise HomeAssistantError(remote_history_command_error(result))

    set_permissions_script = """set -eu
chmod 700 "$HOME/.local/bin/omarchy-homeassistant-ac-history.py"
chmod 700 "$HOME/.local/bin/install-omarchy-homeassistant-ac-history.sh"
"""
    result = run_ssh(
        remote_history_ssh_command(target, port) + ["bash", "-s"],
        input_text=set_permissions_script,
    )
    if result.returncode != 0:
        raise HomeAssistantError(remote_history_command_error(result))

    logger_config: dict[str, Any] = {
        "url": remote_url,
        "token": token,
        "entity_id": entity_id,
        "entity_ids": entity_ids,
        "interval_seconds": 60,
        "history_path": path,
        "retention_hours": MAX_HISTORY_HOURS,
    }
    config_json = json.dumps(logger_config, indent=2) + "\n"
    remote_config_command = (
        "set -eu; umask 077; "
        'config_home="${XDG_CONFIG_HOME:-$HOME/.config}"; '
        'mkdir -p "$config_home/omarchy"; '
        'cat > "$config_home/omarchy/homeassistant-ac-history.json"; '
        'chmod 600 "$config_home/omarchy/homeassistant-ac-history.json"'
    )
    result = run_ssh(
        remote_history_ssh_command(target, port) + ["bash", "-c", shlex.quote(remote_config_command)],
        input_text=config_json,
    )
    if result.returncode != 0:
        raise HomeAssistantError(remote_history_command_error(result))

    run_installer_script = """set -eu
exec "$HOME/.local/bin/install-omarchy-homeassistant-ac-history.sh"
"""
    result = run_ssh(
        remote_history_ssh_command(target, port) + ["bash", "-s"],
        input_text=run_installer_script,
        timeout=45,
    )
    if result.returncode != 0:
        raise HomeAssistantError(remote_history_command_error(result))

    config.update({
        "selected_entities": entity_ids,
        "history_source": "server",
        "history_remote_target": target,
        "history_remote_port": port,
        "history_remote_url": remote_url,
        "history_remote_path": path,
    })
    try:
        save_config(config)
    except OSError as exc:
        raise HomeAssistantError(f"The server logger installed, but local settings could not be saved: {exc}") from exc
    return emit({
        "ok": True,
        "history_source": "server",
        "history_remote_target": target,
        "history_remote_port": port,
        "history_remote_url": remote_url,
        "history_remote_path": path,
        "selected_entities": entity_ids,
        "message": "External server timer installed. It records while the Home Assistant host is on.",
    })


def resolve_state(url: str, token: str, configured_entity: str) -> tuple[dict[str, Any], list[str]]:
    if configured_entity:
        state = api_request(url, token, "GET", f"/api/states/{quote(configured_entity, safe='')}")
        if not isinstance(state, dict):
            raise HomeAssistantError("Home Assistant returned no state for the configured entity")
        return state, [configured_entity]

    states = api_request(url, token, "GET", "/api/states")
    if not isinstance(states, list):
        raise HomeAssistantError("Home Assistant returned an invalid state list")
    candidates = []
    for state in states:
        if not isinstance(state, dict):
            continue
        entity_id = str(state.get("entity_id") or "")
        if not entity_id.startswith("climate."):
            continue
        if str(state.get("state") or "").lower() in {"unknown", "unavailable"}:
            continue
        candidates.append(state)
    if not candidates:
        raise HomeAssistantError("No available climate entity was found on Home Assistant")
    if len(candidates) > 1:
        raise MultipleClimateEntitiesError([str(item.get("entity_id")) for item in candidates])
    return candidates[0], [str(candidates[0].get("entity_id"))]


def resolve_states(url: str, token: str, entity_ids: list[str]) -> list[dict[str, Any]]:
    """Resolve an explicit set of climate entities in a stable user-selected order."""
    normalized = selected_entity_ids(entity_ids)
    if not normalized:
        raise HomeAssistantError("Choose at least one available climate entity")
    raw_states = api_request(url, token, "GET", "/api/states")
    if not isinstance(raw_states, list):
        raise HomeAssistantError("Home Assistant returned an invalid state list")
    state_by_id = {
        str(state.get("entity_id")): state
        for state in raw_states
        if isinstance(state, dict) and climate_entity_id(state.get("entity_id"))
    }
    states = [
        state_by_id[entity_id]
        for entity_id in normalized
        if entity_id in state_by_id
        and str(state_by_id[entity_id].get("state") or "").lower()
        not in {"unknown", "unavailable"}
    ]
    if not states:
        raise HomeAssistantError("No selected climate entity is currently available")
    return states


def configured_entity_ids(config: dict[str, Any], configured_entity: str) -> list[str]:
    """Return the entities used for status, preserving the legacy one-entity default."""
    if preference_enabled(config.get("multi_unit_enabled")):
        selected = selected_entity_ids(config.get("selected_entities"), configured_entity)
        if selected:
            return selected
    fallback = climate_entity_id(configured_entity)
    return [fallback] if fallback else []


def control_entity_ids(
    config: dict[str, Any], configured_entity: str, target_entity: str | None = None
) -> list[str]:
    """Choose one explicit remote or all selected remotes for synced controls."""
    target = climate_entity_id(target_entity)
    selected = configured_entity_ids(config, configured_entity)
    if target:
        if selected and target not in selected:
            raise HomeAssistantError("That air conditioner is not in the selected panel list")
        return [target]
    if preference_enabled(config.get("multi_unit_enabled")) \
            and preference_enabled(config.get("global_sync_controls", True)):
        return selected
    fallback = climate_entity_id(configured_entity)
    return [fallback] if fallback else selected[:1]


def list_entities(url: str, token: str) -> list[dict[str, Any]]:
    states = api_request(url, token, "GET", "/api/states")
    if not isinstance(states, list):
        raise HomeAssistantError("Home Assistant returned an invalid state list")
    entities = []
    for state in states:
        if not isinstance(state, dict):
            continue
        entity_id = str(state.get("entity_id") or "")
        if not entity_id.startswith("climate."):
            continue
        if str(state.get("state") or "").lower() in {"unknown", "unavailable"}:
            continue
        attrs = state.get("attributes") if isinstance(state.get("attributes"), dict) else {}
        entities.append({
            "id": entity_id,
            "name": str(attrs.get("friendly_name") or entity_id),
            "state": str(state.get("state") or "unknown"),
        })
    entities.sort(key=lambda item: (item["name"].lower(), item["id"]))
    return entities


def turn_off_all(url: str, token: str) -> int:
    entities = list_entities(url, token)
    entity_ids = [str(entity["id"]) for entity in entities]
    if not entity_ids:
        return fail("No available Home Assistant climate entities were found")
    try:
        call_service(url, token, "turn_off", {"entity_id": entity_ids})
    except HomeAssistantError as exc:
        verified = verify_all_power_state(url, token, expected_on=False) \
            if request_may_have_reached_home_assistant(exc) else None
        if verified is None:
            raise
        return emit({
            "ok": True,
            "turned_off": verified,
            "count": len(verified),
            "verified": True,
            "message": "Turn-off request timed out, but Home Assistant reports every climate device off.",
        })
    return emit({
        "ok": True,
        "turned_off": entity_ids,
        "count": len(entity_ids),
    })


def turn_on_all(url: str, token: str) -> int:
    entities = list_entities(url, token)
    entity_ids = [str(entity["id"]) for entity in entities]
    if not entity_ids:
        return fail("No available Home Assistant climate entities were found")
    try:
        call_service(url, token, "turn_on", {"entity_id": entity_ids})
    except HomeAssistantError as exc:
        verified = verify_all_power_state(url, token, expected_on=True) \
            if request_may_have_reached_home_assistant(exc) else None
        if verified is None:
            raise
        return emit({
            "ok": True,
            "turned_on": verified,
            "count": len(verified),
            "verified": True,
            "message": "Turn-on request timed out, but Home Assistant reports every climate device on.",
        })
    return emit({
        "ok": True,
        "turned_on": entity_ids,
        "count": len(entity_ids),
    })


