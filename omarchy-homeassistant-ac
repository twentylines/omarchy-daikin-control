class HomeAssistantError(RuntimeError):
    pass


class MultipleClimateEntitiesError(HomeAssistantError):
    def __init__(self, entity_ids: list[str]) -> None:
        self.entity_ids = entity_ids
        super().__init__("Multiple air conditioners found; choose one from the device list")


def emit(payload: dict[str, Any]) -> int:
    print(json.dumps(payload, separators=(",", ":")))
    return 0 if payload.get("ok") else 1


def fail(message: str, **extra: Any) -> int:
    payload: dict[str, Any] = {"ok": False, "error": message}
    payload.update(extra)
    return emit(payload)


def load_config() -> dict[str, Any]:
    try:
        with CONFIG_PATH.open(encoding="utf-8") as handle:
            value = json.load(handle)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as exc:
        raise HomeAssistantError(f"Cannot read {CONFIG_PATH}: {exc}") from exc
    if not isinstance(value, dict):
        raise HomeAssistantError(f"{CONFIG_PATH} must contain a JSON object")
    return value


def preference_enabled(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"1", "true", "on", "yes"}


def _parse_shortcut(value: Any) -> str:
    text = str(value or "").strip().upper()
    if not text:
        return ""
    parts = [part.strip() for part in re.split(r"\s*\+\s*", text)]
    if not parts or any(not part for part in parts):
        return ""

    modifiers: set[str] = set()
    key = ""
    for part in parts:
        modifier = SHORTCUT_MODIFIER_ALIASES.get(part)
        if modifier:
            if modifier in modifiers:
                return ""
            modifiers.add(modifier)
            continue
        normalized = SHORTCUT_KEY_ALIASES.get(part, part)
        if key or (
            normalized not in SHORTCUT_ALLOWED_KEYS
            and not re.fullmatch(r"XF86_[A-Z0-9_]+", normalized)
        ):
            return ""
        key = normalized
    if not key:
        return ""
    ordered_modifiers = [item for item in SHORTCUT_MODIFIER_ORDER if item in modifiers]
    return "+".join(ordered_modifiers + [key])


def normalize_shortcut(value: Any, fallback: str = "") -> str:
    normalized = _parse_shortcut(value)
    if normalized:
        return normalized
    if fallback and str(fallback) != str(value):
        return _parse_shortcut(fallback)
    return ""


def shortcut_settings(config: dict[str, Any]) -> dict[str, dict[str, Any]]:
    raw = config.get("shortcuts")
    result: dict[str, dict[str, Any]] = {}
    for name, default in SHORTCUT_DEFAULTS.items():
        item = raw.get(name) if isinstance(raw, dict) and isinstance(raw.get(name), dict) else {}
        result[name] = {
            "key": normalize_shortcut(item.get("key"), default["key"]),
            "enabled": item.get("enabled", default["enabled"]) is not False,
        }
    return result


def shortcut_hypr_sequence(value: str) -> str:
    punctuation = {
        "COMMA": "comma",
        "PERIOD": "period",
        "SLASH": "slash",
        "SEMICOLON": "semicolon",
        "APOSTROPHE": "apostrophe",
        "BRACKETLEFT": "bracketleft",
        "BRACKETRIGHT": "bracketright",
        "BACKSLASH": "backslash",
        "MINUS": "minus",
        "EQUAL": "equal",
        "QUOTELEFT": "grave",
        "PLUS": "plus",
    }
    aliases = {"ESC": "ESCAPE", "ENTER": "RETURN"}
    return " + ".join(
        aliases.get(part, punctuation.get(part, part))
        for part in normalize_shortcut(value).split("+")
    )


def _shortcut_binding_line(
    key: str, action: str, description: str, hypr_sequence: str | None = None
) -> str:
    target = f"{SHORTCUT_APP_ID}:{action}"
    return (
        f"  hl.bind({json.dumps(hypr_sequence or shortcut_hypr_sequence(key))}, "
        f"hl.dsp.global({json.dumps(target)}), "
        f"{{ description = {json.dumps('Home Assistant AC: ' + description)} }})"
    )


def shortcut_bindings(config: dict[str, Any]) -> list[str]:
    if not preference_enabled(config.get("shortcuts_enabled")):
        return []
    settings = shortcut_settings(config)
    bindings: list[str] = []
    for name, description in SHORTCUT_GLOBAL_ACTIONS:
        item = settings[name]
        if item["enabled"]:
            bindings.append(_shortcut_binding_line(item["key"], name, description))

    if (
        settings["toggle_power"]["enabled"]
        and preference_enabled(config.get("multi_unit_enabled"))
        and not preference_enabled(config.get("global_sync_controls", True))
    ):
        selected = selected_entity_ids(config.get("selected_entities"), config.get("entity_id"))
        if len(selected) < 2:
            return bindings
        base_key = settings["toggle_power"]["key"]
        base_hypr_sequence = shortcut_hypr_sequence(base_key)
        for index, entity_id in enumerate(selected[:9], start=1):
            bindings.append(_shortcut_binding_line(
                base_key,
                f"power_{index}",
                f"AC {index} power ({entity_id})",
                f"{base_hypr_sequence} + {index}",
            ))
    return bindings


def _shortcut_bindings_block(config: dict[str, Any]) -> str:
    bindings = shortcut_bindings(config)
    if not bindings:
        return ""
    return "\n".join([
        SHORTCUT_MARKER_START,
        "do",
        *bindings,
        "end",
        SHORTCUT_MARKER_END,
    ])


def _write_text_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    mode = path.stat().st_mode & 0o777 if path.exists() else 0o600
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(temporary, mode)
        os.replace(temporary, path)
        os.chmod(path, mode)
    except OSError:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def sync_hyprland_shortcuts(config: dict[str, Any]) -> str:
    """Keep the plugin's generated global binds inside a reversible marker block."""
    try:
        original = HYPR_BINDINGS_PATH.read_text(encoding="utf-8") \
            if HYPR_BINDINGS_PATH.exists() else ""
    except OSError as exc:
        return f"Cannot read Hyprland bindings: {exc}"

    marker_pattern = re.compile(
        rf"(?ms)^[ \t]*{re.escape(SHORTCUT_MARKER_START)}\n.*?"
        rf"^[ \t]*{re.escape(SHORTCUT_MARKER_END)}[ \t]*(?:\n|$)"
    )
    without_plugin_block = marker_pattern.sub("", original)
    block = _shortcut_bindings_block(config)
    updated = without_plugin_block
    if block:
        separator = "" if not updated or updated.endswith("\n") else "\n"
        updated = updated + separator + block + "\n"
    if updated == original:
        return ""

    try:
        _write_text_atomic(HYPR_BINDINGS_PATH, updated)
    except OSError as exc:
        return f"Cannot save Hyprland bindings: {exc}"

    try:
        result = subprocess.run(
            ["hyprctl", "reload"],
            check=False,
            capture_output=True,
            text=True,
            timeout=3,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return f"Bindings saved, but Hyprland could not reload: {exc}"
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip().splitlines()
        return "Bindings saved, but Hyprland could not reload" + (
            f": {detail[0]}" if detail else ""
        )
    return ""


def temperature_display(value: Any) -> str:
    text = str(value or "").strip().lower()
    return text if text in {"ambient", "target", "both"} else "both"


def temperature_unit_preference(value: Any) -> str:
    text = str(value or "").strip().lower()
    return text if text in {"source", "celsius", "fahrenheit", "kelvin"} else "source"


def history_hours(value: Any) -> float:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return 24
    if parsed != parsed or not 1 <= parsed <= MAX_HISTORY_HOURS:
        return 24
    return round(parsed, 2)


def effective_history_settings(config: dict[str, Any]) -> tuple[float, bool]:
    """Keep extended and custom ranges unavailable until the experiment is enabled."""
    extended = preference_enabled(config.get("experimental_history_enabled"))
    selected = history_hours(config.get("history_hours"))
    custom = preference_enabled(config.get("history_custom"))
    if not extended:
        return min(selected, 24), False
    return selected, custom


def climate_entity_id(value: Any) -> str:
    text = str(value or "").strip()
    return text if CLIMATE_ENTITY_PATTERN.fullmatch(text) else ""


def selected_entity_ids(value: Any, fallback: Any = "") -> list[str]:
    """Normalize the selected climate list while keeping old single-entity configs valid."""
    raw_items: list[Any]
    if isinstance(value, (list, tuple)):
        raw_items = list(value)
    elif value is None or str(value).strip() == "":
        raw_items = []
    else:
        raw_items = str(value).split(",")
    result: list[str] = []
    for item in raw_items:
        entity_id = climate_entity_id(item)
        if not entity_id or entity_id in result:
            continue
        result.append(entity_id)
        if len(result) >= MAX_SELECTED_ENTITIES:
            break
    fallback_id = climate_entity_id(fallback)
    if not result and fallback_id:
        result.append(fallback_id)
    return result


def bar_temperature_mode(value: Any) -> str:
    text = str(value or "").strip().lower()
    # The former single/current mode was removed from the UI. Treat old saved
    # values as the default average instead of leaving the bar in a hidden mode.
    if text == "single":
        return "average"
    return text if text in {"average", "all", "selected"} else "average"


def bounded_preference(value: Any, minimum: float, maximum: float, default: float) -> float:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return default
    if parsed != parsed:
        return default
    return round(max(minimum, min(maximum, parsed)), 2)


def appearance_hex(value: Any, default: str = DEFAULT_APPEARANCE_ACCENT) -> str:
    text = str(value or "").strip()
    return text.upper() if APPEARANCE_HEX_PATTERN.fullmatch(text) else default


def appearance_color_map(value: Any) -> dict[str, str]:
    """Keep per-device colours limited to valid Home Assistant climate IDs."""
    raw: Any = value
    if isinstance(value, str):
        try:
            raw = json.loads(value)
        except (TypeError, ValueError):
            return {}
    if not isinstance(raw, dict):
        return {}
    result: dict[str, str] = {}
    for entity_id, color in raw.items():
        normalized_id = climate_entity_id(entity_id)
        normalized_color = str(color or "").strip()
        if (
            not normalized_id
            or not APPEARANCE_HEX_PATTERN.fullmatch(normalized_color)
            or normalized_id in result
        ):
            continue
        result[normalized_id] = normalized_color.upper()
        if len(result) >= MAX_SELECTED_ENTITIES:
            break
    return result


